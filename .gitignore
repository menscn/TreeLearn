# IDE / 工具的本地私有数据，不进版本库
.workbuddy/
.superpowers/

# Python 缓存
__pycache__/
*.pyc

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编译产物（Java class 属构建副产物，不作为证据或源码入库）
*.class

# 证据生成脚本的中间捕获（每次运行覆盖，结论段由它派生，本身不进版本库）
artifacts/evidence/.captures/

# 未展开的 %SystemDrive% 在仓库根留下的字面量目录（2026-09-22 发现：里面是 Windows 缓存 .db，
# 由某次把 cmd 风格路径喂给非 cmd 上下文造成）。它不是任何源集的一部分，但会被 git 看见。
# 已核实其绝对路径落在工作区根之下、且仓库内无任何引用；删除受本机删除策略限制，故先禁止入库。
%SystemDrive%/

# Per-line isolated build dirs
build-*/

# 守门脚本的运行期暂存：逐屏截图、UI dump、临时 APK 副本，每次运行覆盖。
# parity / screen_inventory 脚本把这里当输出目录用，所以文件必须留在磁盘上，但不进版本库。
artifacts/tmp/

# 反编译恢复产物（含第三方工具 cfr.jar），只作一次性排查参考，不是仓库交付物。
artifacts/recovery/
