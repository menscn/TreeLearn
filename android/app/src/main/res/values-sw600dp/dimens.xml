<?xml version="1.0" encoding="utf-8"?>
<!--
  Tablet (sw600dp) overrides. The prototype is a phone canvas; on a tablet landscape the page keeps
  a comfortable reading measure instead of stretching a single column across the screen, which is
  what PRD 6.2.16 asks for ("平板横屏合理利用宽度"). The only genuine override is the gutter: the
  reading measure itself (content_measure) lives in the base folder, because a dimen declared only
  here has no fallback in the configurations that do not match this qualifier.
-->
<resources>
    <dimen name="page_gutter">32dp</dimen>
</resources>