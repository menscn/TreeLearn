<?xml version="1.0" encoding="utf-8"?>
<!--
  Tablet home: the same column, capped at a comfortable reading measure and centred, so a landscape
  tablet shows one readable page instead of a single column stretched across the full width. The
  width-consuming screens are the ones with a canvas (T-017) and the conversation (T-013).

  The capsule clearance belongs to the scroll container, so the tablet variant pays it exactly like
  the phone one (T-2026-10-22-062) - the measure is capped, the under-glass travel is not. The topbar
  floats here too (T-2026-10-23-075), and it is capped to the same measure and centred with the column
  so a wide window never shows a full-width bar over a narrow page.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ScrollView
        android:id="@+id/home_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/tab_bar_clearance"
        android:paddingTop="@dimen/top_bar_clearance">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                layout="@layout/screen_home_body"
                android:layout_width="@dimen/content_measure"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />
        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/home_appbar"
        android:layout_width="@dimen/content_measure"
        android:layout_height="@dimen/topbar_height"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/topbar_offset"
        android:background="@drawable/bg_glass_control_bar"
        android:elevation="@dimen/glass_capsule_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s2"
        android:paddingEnd="@dimen/space_s2">

        <ImageView
            android:id="@+id/home_drawer_button"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_home_drawer"
            android:padding="@dimen/space_s2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_menu"
            android:tint="@color/tl_ink2" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/home_settings_button"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_home_settings"
            android:padding="@dimen/space_s2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chat_gear"
            android:tint="@color/tl_ink2" />

    </LinearLayout>
</FrameLayout>

