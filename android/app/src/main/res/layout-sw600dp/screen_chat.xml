<?xml version="1.0" encoding="utf-8"?>
<!--
  Tablet conversation: the same column, capped at a comfortable reading measure and centred. A line of
  prose stretched across a landscape tablet is the one place a wider window makes reading worse, so the
  measure - not the window - decides the column width.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/screen_chat_body"
        android:layout_width="@dimen/content_measure"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal" />

    <!-- T-077: the fullscreen editor (073 §5.1) - full-bleed on the tablet too, no sw600dp variant. -->
    <include
        layout="@layout/overlay_fullscreen_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>