<?xml version="1.0" encoding="utf-8"?>
<!--
  Tablet library: the same column, capped at a comfortable reading measure and centred, so a landscape
  tablet shows one readable list instead of rows stretched across the full width.

  The scroll container pays the floating capsules' room and does not clip it, here as on the phone
  (T-2026-10-22-062, T-2026-10-23-075). The topbar floats and is capped to the same measure as the
  column, so the page's back entry and title stay put over a wide window too. See
  layout/screen_home.xml for why the host holds no padding.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/library_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ScrollView
        android:id="@+id/library_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/tab_bar_clearance"
        android:paddingTop="@dimen/top_bar_clearance">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                layout="@layout/screen_library_body"
                android:layout_width="@dimen/content_measure"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />
        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/library_appbar"
        android:layout_width="@dimen/content_measure"
        android:layout_height="@dimen/topbar_height"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/topbar_offset"
        android:background="@drawable/bg_glass_control_bar"
        android:elevation="@dimen/glass_capsule_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s2"
        android:paddingEnd="@dimen/space_s2">

        <ImageView
            android:id="@+id/library_back"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_library_back"
            android:padding="@dimen/space_s2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/tl_ink2" />

        <TextView
            android:id="@+id/library_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s2"
            android:fontFamily="@font/noto_serif_sc"
            android:letterSpacing="0.02"
            android:text="@string/library_title"
            android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_library_title"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

