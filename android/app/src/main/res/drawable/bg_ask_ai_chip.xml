<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-09-28: the 问 AI quick-query chip. The green outline is the action color (the send fab
     uses the same token), so the three chips read as tappable while the quote row's filled green
     keeps meaning "context already attached". Pressed state fills green_soft, matching the
     hover step the prototype draws on rec-chip. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tl_green_soft" />
            <corners android:radius="@dimen/radius_full" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tl_surface" />
            <stroke android:width="@dimen/hairline" android:color="@color/tl_green" />
            <corners android:radius="@dimen/radius_full" />
        </shape>
    </item>
</selector>
