<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card (2026-10-21 material): sheen underneath a translucent fill, plus the 1px edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/glass_sheen" />
            <corners android:radius="@dimen/radius_xl" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/glass_card_lo"
                android:startColor="@color/glass_card" />
            <stroke android:width="@dimen/hairline" android:color="@color/glass_edge" />
            <corners android:radius="@dimen/radius_xl" />
        </shape>
    </item>
</layer-list>
