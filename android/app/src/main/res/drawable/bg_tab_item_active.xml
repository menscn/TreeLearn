<?xml version="1.0" encoding="utf-8"?>
<!--
  The selected tab's pill (Scheme A .tab.is-active): the proposal's "tab-active" is a local
  rgba(255,255,255,.62); the token authority has no such colour, so the existing glass sheen
  (50% white) is the closest registered value. The edge keeps it from dissolving into the capsule.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_sheen" />
            <corners android:radius="@dimen/radius_full" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/hairline" android:color="@color/glass_edge" />
            <corners android:radius="@dimen/radius_full" />
        </shape>
    </item>
</layer-list>
