<?xml version="1.0" encoding="utf-8"?>
<!-- A popover floats over content, so it takes the prototype's solid surface, not the glass card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tl_surface" />
    <corners android:radius="@dimen/radius_lg" />
    <stroke
        android:width="@dimen/hairline"
        android:color="@color/tl_line" />
</shape>
