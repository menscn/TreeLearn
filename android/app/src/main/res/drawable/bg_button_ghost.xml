<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tl_green_faint" />
            <stroke android:width="@dimen/hairline" android:color="@color/tl_green" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tl_surface" />
            <stroke android:width="@dimen/hairline" android:color="@color/tl_line" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</selector>