<?xml version="1.0" encoding="utf-8"?>
<!--
  The selected library segment (Scheme A .segment .seg.is-active): a bright glass face inside the
  shared capsule. The proposal draws it 32px tall inside a 40px container; this project keeps the
  44dp touch floor, so the segment view is 44dp and the visible face is inset 4dp top and bottom -
  the same face-inside-target split the chat action dots use.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="@dimen/space_s1"
        android:top="@dimen/space_s1">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_sheen" />
            <stroke android:width="@dimen/hairline" android:color="@color/glass_edge" />
            <corners android:radius="@dimen/radius_full" />
        </shape>
    </item>
</layer-list>
