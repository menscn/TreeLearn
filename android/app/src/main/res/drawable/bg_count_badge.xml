<?xml version="1.0" encoding="utf-8"?>
<!-- The child-branch count badge on the answer action row's tree glyph (prototype .ai-act-n,
     Docs/04-ux-design/知芽-TreeLearn-高保真原型-v1.1.html line 232: min-width 14px, height 14px,
     radius full, green fill, white 9.5px text). A full pill rather than a circle, so a
     two-digit count still reads: the view sets minWidth 14dp and the ends round off whatever width
     the number needs. The badge is decor - the count is already spoken by the container's
     contentDescription - so it carries no content description of its own. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/tl_green" />
    <corners android:radius="@dimen/space_s2" />
</shape>
