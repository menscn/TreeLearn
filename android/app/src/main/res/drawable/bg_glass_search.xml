<?xml version="1.0" encoding="utf-8"?>
<!--
  Scheme A's library searchbar (.searchbar, 44px, border-radius 999px): the same glass field fill
  and 1px highlight edge as every other field, but at the capsule radius. The generic bg_glass_field
  keeps the 18dp field corner, which is why the library owns this sibling shape instead of tinting
  one over the other.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/glass_field_lo"
        android:startColor="@color/glass_field" />
    <stroke android:width="@dimen/hairline" android:color="@color/glass_edge" />
    <corners android:radius="@dimen/radius_full" />
</shape>
