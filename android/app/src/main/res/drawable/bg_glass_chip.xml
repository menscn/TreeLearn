<?xml version="1.0" encoding="utf-8"?>
<!-- Glass chip/pill: the compact card fill at the full radius. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/glass_card_lo"
                android:startColor="@color/glass_card" />
            <stroke android:width="@dimen/hairline" android:color="@color/glass_edge" />
            <corners android:radius="@dimen/radius_full" />
        </shape>
    </item>
</layer-list>
