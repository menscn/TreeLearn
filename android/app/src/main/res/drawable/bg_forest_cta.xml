<?xml version="1.0" encoding="utf-8"?>
<!-- The empty forest's way back to the composer, and the error pane's retry. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_primary">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tl_green_deep" />
                    <corners android:radius="@dimen/radius_full" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tl_green" />
                    <corners android:radius="@dimen/radius_full" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
