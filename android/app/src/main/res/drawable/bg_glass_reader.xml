<?xml version="1.0" encoding="utf-8"?>
<!-- Reading surface: the one place the glass stays at 86% white for long-form contrast. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/glass_sheen" />
            <corners android:radius="@dimen/radius_2xl" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/glass_reader_lo"
                android:startColor="@color/glass_reader" />
            <stroke android:width="@dimen/hairline" android:color="@color/glass_edge" />
            <corners android:radius="@dimen/radius_2xl" />
        </shape>
    </item>
</layer-list>
