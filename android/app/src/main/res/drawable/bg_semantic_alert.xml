<?xml version="1.0" encoding="utf-8"?>
<!-- Failure surface: keeps the soft-red fill the chat spec pins, but owns an opaque shape so no
     backgroundTint has to flatten a glass edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/tl_red_soft" />
    <stroke android:width="@dimen/hairline" android:color="@color/tl_line" />
    <corners android:radius="@dimen/radius_lg" />
</shape>
