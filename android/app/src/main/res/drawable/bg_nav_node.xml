<?xml version="1.0" encoding="utf-8"?>
<!--
  The branch row's node (Scheme A .branch-row .node): a 22dp circle, 26% white inside a 45% green
  ring. The two alphas live on the layer items because the palette's green is an opaque token; the
  ring is the identity, the fill is only what keeps the tree glyph legible on the glass row.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.26">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item android:alpha="0.45">
        <shape android:shape="oval">
            <stroke android:width="@dimen/hairline" android:color="@color/tl_green" />
        </shape>
    </item>
</layer-list>
