<?xml version="1.0" encoding="utf-8"?>
<!-- Home history-topic card surface (prototype .topic-card, Docs/04-ux-design/知芽-TreeLearn-高保真原型-v1.html
     line 167: surface, no border, radius r-md, sh-1 carried by elevation).

     Deliberately not bg_card: that one is the shared radius_lg surface used by a dozen other layouts,
     and the prototype gives the topic card the smaller card radius. The spec's shared-resource freeze
     says a home-specific shape gets its own resource rather than bending the shared one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/tl_surface" />
    <corners android:radius="@dimen/radius_md" />
</shape>
