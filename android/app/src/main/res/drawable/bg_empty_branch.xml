<?xml version="1.0" encoding="utf-8"?>
<!--
  The empty-branch note (Scheme A .empty-branch): a dashed 14dp card. The dash is what makes it read
  as a place where a branch will grow, not as another selectable row.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="@dimen/hairline"
        android:color="@color/glass_line"
        android:dashGap="3dp"
        android:dashWidth="4dp" />
    <corners android:radius="@dimen/radius_md" />
</shape>
