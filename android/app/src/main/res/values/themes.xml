<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Platform Material theme on purpose: TreeLearn ships zero AndroidX UI
      libraries so that no Kotlin stdlib can leak into the APK.
    -->
    <style name="Theme.TreeLearn" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/tl_green</item>
        <item name="android:colorPrimaryDark">@color/tl_green_deep</item>
        <item name="android:colorAccent">@color/tl_green</item>
        <item name="android:windowBackground">@color/tl_bg</item>
        <item name="android:textColorPrimary">@color/tl_ink</item>
        <item name="android:textColorSecondary">@color/tl_ink2</item>
        <item name="android:textColorHint">@color/tl_ink3</item>
        <item name="android:statusBarColor">@color/tl_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
