<?xml version="1.0" encoding="utf-8"?>
<!-- Custom attributes for HeatmapView (T-2026-09-23-101). -->
<resources>
    <declare-styleable name="HeatmapView">
        <!-- strip: single-row bar (last 14 days mini card); grid: weeks grid (drawer/detail). -->
        <attr name="tl_mode" format="enum">
            <enum name="strip" value="0"/>
            <enum name="grid" value="1"/>
        </attr>
        <attr name="tl_rows" format="integer"/>
        <attr name="tl_columns" format="integer"/>
        <attr name="tl_cellSize" format="dimension"/>
        <attr name="tl_gap" format="dimension"/>
        <!-- Color token (or reference) painted for empty cells; all cells when data is empty. -->
        <attr name="tl_emptyColor" format="color|reference"/>
    </declare-styleable>
</resources>
