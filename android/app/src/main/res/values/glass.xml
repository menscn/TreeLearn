<?xml version="1.0" encoding="utf-8"?>
<!--
  Android copy of the translucent glass tokens (T-2026-10-21-049).

  values/colors.xml accepts opaque six-digit hex only: check_design_tokens.py maps every opaque
  token to exactly one tl_* resource and rejects extras. The glass surfaces are rgba, so their
  Android copy lives here as eight-digit ARGB. These values are not hand-maintained facts:
  GlassMaterialTokensTest reads tokens.json and recomputes the alpha, so editing a token in the
  prototype without syncing this file fails the JVM suite.
-->
<resources>
    <color name="glass_chrome">#BDFFFFFF</color>
    <color name="glass_card">#DBFFFFFF</color>
    <color name="glass_reader">#EDFFFFFF</color>
    <color name="glass_field">#BDF4F1EB</color>
    <color name="glass_control">#FAFFFFFF</color>
    <color name="glass_edge">#E0FFFFFF</color>
    <color name="glass_line">#0F16241C</color>
    <color name="glass_sheen">#80FFFFFF</color>
    <color name="glass_shadow_key">#6B16241C</color>
    <color name="glass_shadow_ambient">#0D16241C</color>
    <color name="glow_green">#292B6E45</color>
    <color name="glow_sand">#33D6A96E</color>
    <color name="glow_white">#7AFFFFFF</color>
    <color name="glow_rose">#2EC9A4A2</color>
    <color name="glow_lilac">#29A39CBA</color>
    <!--
      The tint's dark ends are not tokens: each one is its own surface's alpha times the single
      glass-tint-falloff ratio, so the 93% reader keeps a brighter bottom edge than the 74% chrome
      instead of sharing one literal. GlassMaterialTokensTest recomputes all four from tokens.json
      and rejects a copy that drifts, which is what makes these safe to keep next to the mirrors.
      glass_control has no _lo on purpose: the control face is flat, because a tint that darkens a
      62dp pill toward its lower edge is exactly what let two layers of text blur into each other.
    -->
    <color name="glass_chrome_lo">#6EFFFFFF</color>
    <color name="glass_card_lo">#7FFFFFFF</color>
    <color name="glass_reader_lo">#89FFFFFF</color>
    <color name="glass_field_lo">#6EF4F1EB</color>
</resources>
