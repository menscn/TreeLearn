<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the conversation (prototype v2.5 `.msg-user` / `.msg-ai`). Both roles share the file:
  the row shows one block or the other, so a rebuilt list has exactly one place a row can come from.

  The reasoning disclosure and the action row are views of their own, because each is a rule-bound
  component: the disclosure owns "collapsed unless opened, and only when there is reasoning", and the
  action row owns "enabled only where the store would accept the action".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_s4"
    android:paddingBottom="@dimen/space_s4">

    <!-- Learner row: the question as plain text (prototype .msg-user, line 182). 2026-09-27 user
         decision: the page follows the design shot, so the grey card becomes a green bubble; the
         quoted sentence rides inside it as a light pill (prototype .quote-in, line 405, tokenised to
         the solid surface). 2026-09-28 user decision: the green bubble itself is gone as well - the
         question now reads as body text with no background of its own, the same treatment the AI
         answer gets, so the two roles differ only by the tag above them and the question's being
         right-aligned. -->
    <LinearLayout
        android:id="@+id/chat_question_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Scheme A's .user-msg .who: 9sp, letterspaced, right-aligned above the question. -->
        <TextView
            android:id="@+id/chat_user_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="3dp"
            android:letterSpacing=".14"
            android:text="@string/chat_user_tag"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_chat_who" />

        <TextView
            android:id="@+id/chat_quote_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/tl_green_faint"
            android:paddingStart="@dimen/space_s2"
            android:paddingTop="@dimen/space_s1"
            android:paddingEnd="@dimen/space_s2"
            android:paddingBottom="@dimen/space_s1"
            android:textColor="@color/tl_green_deep"
            android:textSize="@dimen/text_cap"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chat_question"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s1"
            android:lineSpacingMultiplier="1.65"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_chat_user" />
    </LinearLayout>

    <!-- Answer row. -->
    <LinearLayout
        android:id="@+id/chat_answer_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <!-- 2026-09-27 user decision: the tag is the plain brand + spark (prototype .at-brand,
             line 187) instead of the grey chip. The time left this line for the action row
             (prototype puts .ai-time inside .ai-actions, line 877). -->
        <TextView
            android:id="@+id/chat_ai_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_brand_sprout"
            android:drawablePadding="5dp"
            android:drawableTint="@color/tl_green"
            android:gravity="center_vertical"
            android:letterSpacing=".1"
            android:text="@string/chat_ai_tag"
            android:textColor="@color/tl_green"
            android:textSize="@dimen/text_ai_tag"
            android:textStyle="bold" />
    </LinearLayout>

        <com.treelearn.app.screen.ReasoningDisclosure
            android:id="@+id/chat_reasoning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 2026-09-27 user decision: the green left edge is voided with the design shot (spec
             V1.1 §3.3) - AI identity is the spark tag, not a rule, so the body sits flush and the
             hierarchy stays one container deep. The reasoning disclosure keeps its own tl_line. -->
        <TextView
            android:id="@+id/chat_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.82"
            android:textColor="@color/tl_ink"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_answer"
            android:visibility="gone" />

        <!-- 2026-09-28 user decision: a GFM table is not text. Monospaced box drawing cannot line up
             inside a match_parent TextView, because a wide row soft-wraps and every following box
             character lands in the wrong column. The answer body is now this host: prose runs are
             TextViews and tables are real TableLayouts, concatenated in document order. -->
        <LinearLayout
            android:id="@+id/chat_answer_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- T-075: the streaming caret (073 §4.1) - its own reserved slot, visible only in the
             answering stage, so no other slot's hit box ever moves when it appears. -->
        <View android:id="@+id/chat_caret" android:layout_width="@dimen/caret_width"
            android:layout_height="@dimen/space_s4" android:layout_marginTop="@dimen/space_s1"
            android:background="@color/tl_green"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chat_generating_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s3"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_cap"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/chat_failure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s3"
            android:background="@drawable/bg_semantic_alert"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_s4"
            android:paddingEnd="@dimen/space_s4"
            android:paddingTop="@dimen/space_s3"
            android:paddingBottom="@dimen/space_s3"
            android:visibility="gone">

            <TextView
                android:id="@+id/chat_failure_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_failed"
                android:textColor="@color/tl_red"
                android:textSize="@dimen/text_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chat_retry_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/chat_retry_hint"
                    android:textColor="@color/tl_ink3"
                    android:textSize="@dimen/text_cap" />

                <Button
                    android:id="@+id/chat_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_button_ghost"
                    android:minWidth="@dimen/touch_min"
                    android:stateListAnimator="@null"
                    android:text="@string/chat_retry"
                    android:textColor="@color/tl_action_text"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/chat_canceled" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s3"
            android:text="@string/chat_stopped" android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_sm" android:visibility="gone" />

        <!-- T-090: the translation display. A derived presentation below the answer, never a
             replacement for it: the header folds and unfolds (44dp), and the body only shows a
             finished translation. -->
        <LinearLayout
            android:id="@+id/chat_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s3"
            android:background="@drawable/bg_semantic_note"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_s3"
            android:paddingEnd="@dimen/space_s3"
            android:paddingTop="@dimen/space_s1"
            android:paddingBottom="@dimen/space_s3"
            android:visibility="gone">

            <!-- 2026-10-16: the header takes the row highlight like the source card's header does.
                 It is a tap target (fold, and retry after a failed translation) that used to answer a
                 tap with nothing at all. -->
            <TextView
                android:id="@+id/chat_translation_header"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:textColor="@color/tl_action_text"
                android:textSize="@dimen/text_cap" />

            <TextView
                android:id="@+id/chat_translation_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tl_ink2"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>

        <com.treelearn.app.screen.AnswerActionBar
            android:id="@+id/chat_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Scheme A's inline branch stack (.branch-label + .branch-stack): the children of this
             answer, drawn under its action row instead of in a window-level popup. The section is
             hidden until the presenter has read the real ChildBranch list for this answer; the
             rail is a 1dp green fade with a 5dp dot at its head, and every row is a 14dp glass
             card. It lives inside the message flow, so it scrolls with the answer it belongs to
             and never covers another row. -->
        <LinearLayout
            android:id="@+id/chat_branch_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/chat_branch_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/branch_label_top"
                android:layout_marginBottom="@dimen/branch_label_bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/branch_icon"
                    android:layout_height="@dimen/branch_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_action_fork"
                    android:tint="@color/tl_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/branch_label_gap"
                    android:letterSpacing=".1"
                    android:text="@string/chat_branch_continue"
                    android:textColor="@color/tl_ink3"
                    android:textSize="@dimen/text_branch_label"
                    android:textStyle="bold" />

                <!-- The rule that runs from the label to the edge, as in the proposal. -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/branch_line"
                    android:layout_marginStart="@dimen/branch_label_gap"
                    android:layout_weight="1"
                    android:background="@color/tl_line" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chat_branch_stack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/branch_gutter">

                <FrameLayout
                    android:layout_width="@dimen/branch_rail"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="@dimen/branch_line"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/bg_branch_line" />

                    <View
                        android:layout_width="@dimen/branch_rail"
                        android:layout_height="@dimen/branch_rail"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/bg_branch_dot" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/chat_branch_list"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/branch_item_gap" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s3"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
