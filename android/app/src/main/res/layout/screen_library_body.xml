<?xml version="1.0" encoding="utf-8"?>
<!--
  The library column, aligned to Scheme A's fifth figure on 2026-10-22 (T-2026-10-22-057) and re-drawn
  on the 2026-10-25 board (T-2026-10-25-102): the 44dp pill search field, then either the glass segment
  capsule (both segments have rows) or one line naming the only segment that does, the compact glass
  topic cards, and the sprout note that closes the page. Shared by the phone page and the tablet page,
  so the two cannot drift.

  The floating glass capsule topbar with the serif page title is not in this column: since
  2026-10-23-075 it lives in layout/screen_library.xml, pinned over the scroll container, so the
  page's only back entry and its title stay on screen while the rows move under the glass.

  The list container `library_rows` is the three contents' shared container: the 「进行中」 segment
  fills it with topic rows, the 「已完成」 segment with archived branch rows, and the search box with
  hit rows while a query is live - so a row is always found in the same place.

  What is deliberately not the proposal's raw number: the segment capsule is Scheme A's 40dp face, but
  the two halves are 44dp tall touch targets. The bright selected face is a 4dp-inset drawable inside
  that target, which keeps the visible pill at the proposal's proportions without putting the page's
  two filters below this project's touch floor.

  `library_search_input` is a real control since 054: its text goes to `LibraryPresenter` (and on
  to the search stack), and the results replace the list in place. The two segment halves are also
  real controls, wired by `LibraryScreen`; tapping one leaves the search state. The note is a
  browsing-state line, so `LibraryScreen` hides it while a query is on screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_s6">

    <EditText
        android:id="@+id/library_search_input"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="@dimen/library_body_top"
        android:layout_marginEnd="@dimen/page_gutter"
        android:background="@drawable/bg_library_search"
        android:cursorVisible="true"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="@dimen/space_s2"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="@string/library_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:includeFontPadding="false"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/library_search_pad"
        android:paddingEnd="@dimen/library_search_pad"
        android:textColor="@color/tl_ink"
        android:textColorHint="@color/tl_ink3"
        android:textSize="@dimen/text_library_search" />

    <TextView
        android:id="@+id/library_search_scope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_s2"
        android:paddingEnd="@dimen/page_gutter"
        android:text="@string/library_search_scope"
        android:textColor="@color/tl_ink3"
        android:textSize="@dimen/text_cap"
        android:visibility="gone" />

    <!-- 2026-10-25 (T-2026-10-25-102): when only one segment has rows the capsule is not drawn at
         all - a two-half control with one empty half offers a switch to nothing and costs 44dp above
         the first row. This line takes its place: the live segment's name and count, 13sp/600 for the
         name and 12sp/400 gray for the count, exactly the board's .lstate. It is a label, not a
         control, so it is not given a tap target. -->
    <TextView
        android:id="@+id/library_segment_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="@dimen/library_state_top"
        android:layout_marginEnd="@dimen/page_gutter"
        android:layout_marginBottom="@dimen/library_state_bottom"
        android:includeFontPadding="false"
        android:textColor="@color/tl_ink"
        android:textSize="@dimen/text_library_segment"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- One capsule, two halves. The halves stay 44dp tall; only the bright face is inset (see the
         comment above), so the touch floor survives without changing the visible proportion. -->
    <LinearLayout
        android:id="@+id/library_segment"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="@dimen/library_segment_top"
        android:layout_marginEnd="@dimen/page_gutter"
        android:background="@drawable/bg_library_segment"
        android:orientation="horizontal"
        android:paddingStart="@dimen/library_segment_pad"
        android:paddingEnd="@dimen/library_segment_pad">

        <TextView
            android:id="@+id/library_segment_in_progress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textSize="@dimen/text_library_segment" />

        <TextView
            android:id="@+id/library_segment_done"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/library_segment_gap"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textSize="@dimen/text_library_segment" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/library_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/library_list_top"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/library_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_s6"
        android:paddingEnd="@dimen/page_gutter"
        android:textColor="@color/tl_ink3"
        android:textSize="@dimen/text_sm"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/library_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="@dimen/library_note_top"
        android:layout_marginEnd="@dimen/page_gutter"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s1"
        android:paddingEnd="@dimen/space_s1">

        <ImageView
            android:id="@+id/library_note_icon"
            android:layout_width="@dimen/library_note_icon"
            android:layout_height="@dimen/library_note_icon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_brand_sprout"
            android:tint="@color/tl_green" />

        <TextView
            android:id="@+id/library_note_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/library_note_gap"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.6"
            android:text="@string/library_note"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_library_note" />
    </LinearLayout>
</LinearLayout>
