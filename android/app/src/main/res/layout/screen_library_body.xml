<?xml version="1.0" encoding="utf-8"?>
<!--
  The library column (T-052, PRD 6.2.16 point 4): the title, the search box, the two segments and
  the list. Shared by the phone page and the tablet page, so the two cannot drift - both
  `layout/screen_library.xml` and `layout-sw600dp/screen_library.xml` include this one column.

  The list container `library_rows` is the three contents' shared container: the 「进行中」 segment
  fills it with topic rows, the 「已完成」 segment (053) with archived branch rows, and the search
  box (054) with hit rows while a query is live - so a row is always found in the same place.

  `library_search_input` is a real control since 054: its text goes to `LibraryPresenter` (and on
  to the search stack), and the results replace the list in place. The two segment pills are also
  real controls, wired by `LibraryScreen`; tapping one leaves the search state.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="@dimen/space_s6">

    <!-- 2026-09-28 user decision: this title and the settings page's title are the same kind of
         thing, so they must read as one style. The settings header sets the size (text_h1), the
         weight (bold) and the ink (tl_ink); previously the library used text_h2 and the two pages
         disagreed. The library has no back arrow (it is a first-level tab), so a touch_min-wide,
         empty lead view takes the arrow's place - that is what makes the two titles' left edges line
         up instead of the library's starting a whole arrow-width to the left. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_s4"
        android:paddingEnd="@dimen/page_gutter">

        <View
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="-8dp" />

        <TextView android:id="@+id/library_title" android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s2"
            android:text="@string/library_title"
            android:textColor="@color/tl_ink" android:textSize="@dimen/text_h1"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText android:id="@+id/library_search_input" android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min" android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="@dimen/space_s3" android:layout_marginEnd="@dimen/page_gutter"
        android:background="@drawable/bg_library_search" android:cursorVisible="true"
        android:drawableStart="@drawable/ic_search" android:drawablePadding="@dimen/space_s2"
        android:focusable="true" android:focusableInTouchMode="true"
        android:hint="@string/library_search_hint" android:includeFontPadding="false"
        android:imeOptions="actionSearch" android:importantForAutofill="no"
        android:inputType="text" android:maxLines="1"
        android:paddingStart="@dimen/space_s3" android:paddingEnd="@dimen/space_s3"
        android:textColorHint="@color/tl_ink3" android:textSize="@dimen/text_sm" />

    <TextView android:id="@+id/library_search_scope" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_s2" android:paddingEnd="@dimen/page_gutter"
        android:text="@string/library_search_scope" android:textColor="@color/tl_ink3"
        android:textSize="@dimen/text_cap" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter" android:layout_marginTop="@dimen/space_s3"
        android:layout_marginEnd="@dimen/page_gutter" android:orientation="horizontal">

        <TextView android:id="@+id/library_segment_in_progress" android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min" android:background="@drawable/bg_library_segment"
            android:backgroundTint="@color/tl_green_soft" android:clickable="true"
            android:focusable="true" android:gravity="center"
            android:minWidth="88dp" android:paddingStart="@dimen/space_s4"
            android:paddingEnd="@dimen/space_s4" android:text="@string/library_segment_in_progress"
            android:textColor="@color/tl_green_deep" android:textSize="@dimen/text_sm" />

        <TextView android:id="@+id/library_segment_done" android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min" android:layout_marginStart="@dimen/space_s2"
            android:background="@drawable/bg_library_segment" android:backgroundTint="@color/tl_surface"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:minWidth="88dp" android:paddingStart="@dimen/space_s4"
            android:paddingEnd="@dimen/space_s4" android:text="@string/library_segment_done"
            android:textColor="@color/tl_ink3" android:textSize="@dimen/text_sm" />
    </LinearLayout>

    <LinearLayout android:id="@+id/library_rows" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" />

    <TextView android:id="@+id/library_state" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:paddingStart="@dimen/page_gutter" android:paddingTop="@dimen/space_s6"
        android:paddingEnd="@dimen/page_gutter" android:textColor="@color/tl_ink3"
        android:textSize="@dimen/text_sm" android:visibility="gone" />
</LinearLayout>
