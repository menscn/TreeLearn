<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's last row: a separator plus this row lead to the static introduction page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_s3"
    android:paddingTop="@dimen/space_s2"
    android:paddingEnd="@dimen/space_s3"
    android:paddingBottom="@dimen/space_s2">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_sparkle"
        android:tint="@color/tl_green_deep" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s2"
        android:layout_weight="1"
        android:text="@string/persona_intro_more"
        android:textColor="@color/tl_green_deep"
        android:textSize="@dimen/text_sm"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/tl_ink3" />
</LinearLayout>
