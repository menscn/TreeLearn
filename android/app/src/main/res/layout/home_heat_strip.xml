<?xml version="1.0" encoding="utf-8"?>
<!--
  The mini heat strip card (T-2026-09-23-102): the last 14 days plus the streak line, included
  below the greeting area of the home body. Three states driven by HomeViewState.HeatStrip:
  gone (query failed or not landed), the empty copy (no rows, never "0 天"), or streak + strip.
  Tapping opens the home drawer (T-103); until that ships the tap is a no-op.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_heat_strip_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/page_gutter"
    android:layout_marginTop="@dimen/space_s4"
    android:layout_marginEnd="@dimen/page_gutter"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/home_heat_cd"
    android:elevation="@dimen/card_elevation"
    android:minHeight="@dimen/touch_min"
    android:orientation="vertical"
    android:padding="@dimen/space_s4"
    android:visibility="gone">

    <TextView
        android:id="@+id/home_heat_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tl_ink"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/home_heat_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_heat_empty"
        android:textColor="@color/tl_ink3"
        android:textSize="@dimen/text_sm" />

    <com.treelearn.app.ui.HeatmapView
        android:id="@+id/home_heat_cells"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s2"
        android:contentDescription="@string/home_heat_cells_cd"
        android:visibility="gone"
        tl:tl_columns="14"
        tl:tl_mode="strip"
        tl:tl_rows="1" />
</LinearLayout>
