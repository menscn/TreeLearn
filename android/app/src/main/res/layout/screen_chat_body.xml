<?xml version="1.0" encoding="utf-8"?>
<!--
  The conversation column (technical design 13, prototype v2.5 `.chat`):
  a fixed app bar, the scrolling message flow, and the composer pinned to the bottom.

  Every control that a state can disable carries an id so the screen can render it from one
  ChatViewState; nothing here holds a decision of its own. Text labels are used where the prototype
  draws icons: this round has no device to check a vector path's rendering, and a label is also
  self-describing without a tooltip.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- App bar: back to the home screen, branch title, settings. -->
    <LinearLayout
        android:id="@+id/chat_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s2"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingTop="@dimen/space_s2">

        <ImageView
            android:id="@+id/chat_back"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_chat_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/tl_green_deep" />

        <TextView
            android:id="@+id/chat_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s2"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_h2"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/chat_nav"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_chat_nav"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_tree"
            android:tint="@color/tl_green_deep" />

        <ImageView
            android:id="@+id/chat_overview"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_chat_overview"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chat_overview"
            android:tint="@color/tl_green_deep" />

        <ImageView
            android:id="@+id/chat_settings"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_chat_settings"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chat_gear"
            android:tint="@color/tl_green_deep" />
    </LinearLayout>

    <!--
      The notice bar: one line for whatever category the presenter reported, hidden until there is
      something to tell. Its colour is set by NoticeText at draw time, because a note and a failure
      are not the same colour - so no colour belongs here, where a second one would be a second answer.
    -->
    <TextView
        android:id="@+id/chat_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="@dimen/space_s2"
        android:layout_marginEnd="@dimen/page_gutter"
        android:textSize="@dimen/text_sm"
        android:visibility="gone" />

    <!--
      The message flow. It scrolls; the composer below it does not. T-075: the flow and its floating
      "回到最新" button share one frame, so the button overlays the content and its appearing or
      disappearing can never move the composer's or the app bar's hit boxes (073 §4 总则).
    -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <com.treelearn.app.screen.FollowScrollView
            android:id="@+id/chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingBottom="@dimen/space_s4">

        <!-- T-065: the source card of a non-root branch - collapsed to the summary line, the
             upstream history only after the learner opens it. Read-only: no row is tappable. -->
        <LinearLayout
            android:id="@+id/chat_source_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_s2"
            android:background="@color/tl_green_faint"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/chat_source_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:orientation="horizontal"
                android:paddingStart="@dimen/page_gutter"
                android:paddingTop="@dimen/space_s2"
                android:paddingEnd="@dimen/page_gutter"
                android:paddingBottom="@dimen/space_s2">

                <TextView
                    android:id="@+id/chat_source_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_s2"
                    android:text="@string/source_card_title"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_cap"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chat_source_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/tl_ink2"
                    android:textSize="@dimen/text_cap" />

                <TextView
                    android:id="@+id/chat_source_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s2"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_cap" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chat_source_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_s2"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/chat_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s4"
                android:text="@string/chat_loading"
                android:textColor="@color/tl_ink3"
                android:textSize="@dimen/text_sm"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chat_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s4"
                android:text="@string/chat_error"
                android:textColor="@color/tl_red"
                android:textSize="@dimen/text_sm"
                android:visibility="gone" />


        </LinearLayout>
        </com.treelearn.app.screen.FollowScrollView>

        <!-- T-075: the follow-latest key (073 §6). 2026-10-16 user decision: it was a text pill, so it
             grew wider every time a missed item joined the label ("这个背景太傻大了", and nothing stays
             fixed when its own width keeps changing). It is now a fixed 44dp rounded rectangle holding
             one down chevron, and the count rides a badge in the corner the way the answer row's child
             entry already does it. The slot is what floats (gravity bottom|center over the scroll
             region); the key inside never resizes. The slot is also the only visibility switch - the
             key is always visible inside it, so a hidden key and a hidden slot can never disagree. -->
        <FrameLayout
            android:id="@+id/chat_follow_slot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/space_s3"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/chat_follow"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_follow_latest"
                android:contentDescription="@string/chat_back_to_latest"
                android:elevation="@dimen/space_s1"
                android:scaleType="center"
                android:src="@drawable/ic_chevron_down"
                android:stateListAnimator="@null"
                android:tint="@color/tl_action_text" />

            <!-- The missed count, decor: the key's content description already names it, so a screen
                 reader must not read the number twice. -->
            <TextView
                android:id="@+id/chat_follow_count"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_count_badge"
                android:elevation="@dimen/space_s1"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="14dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:textColor="@color/tl_surface"
                android:textSize="9.5sp"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <!-- The quoted sentence the next question will be asked from. -->
    <LinearLayout
        android:id="@+id/chat_quote_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tl_green_faint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/space_s2"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_quote_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="@dimen/space_s2"
            android:paddingBottom="@dimen/space_s2"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_sm" />

        <ImageView
            android:id="@+id/chat_quote_clear"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_chat_quote_clear"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chat_close"
            android:tint="@color/tl_ink2" />
    </LinearLayout>

    <!-- The attachment the next question will carry (T-097); mutually exclusive with the quote
         row, which is the presenter's decision, so at most one of the two rows shows at a time. -->
    <LinearLayout
        android:id="@+id/chat_attach_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tl_green_faint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/space_s2"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_attach_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="@dimen/space_s2"
            android:paddingBottom="@dimen/space_s2"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_sm" />

        <ImageView
            android:id="@+id/chat_attach_clear"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_chat_attachment_remove"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chat_close"
            android:tint="@color/tl_ink2" />
    </LinearLayout>

    <!-- Composer 2026-09-27 user decision: the two-level card the design shot shows (prototype
         .composer, line 906-940) - the draft on top, the tools row under it, the circular send at
         the right. The web-search chip and the voice entry stay hidden (user: 联网/录音暂不需要);
         every id the screen binds is preserved, only the tree around them changed. -->
    <LinearLayout
        android:id="@+id/chat_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tl_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_s2"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingBottom="@dimen/space_s2">

        <!-- 2026-09-28 user decision: after 问 AI picks the selection, three one-tap queries show
             here - between the quote row above and the draft below, inside the composer card. Each
             chip sends its query as-is (the draft is kept) and the row collapses on send, so the
             frames exist to be tapped once. The visible pill is the model chip's 32dp class; the
             44dp hot zone is the hosting frame, the split ModelThinkingPicker already uses. -->
        <!-- 2026-10-16 user decision: the chip's hot zone stops drawing its own highlight. The frame
             is a 44dp box around a 32dp pill, so ?android:attr/selectableItemBackground lit a rectangle
             noticeably larger than the control the learner aimed at - the oversized background marked
             out on this round's shot. The frame keeps the click and the touch target; the pill draws
             the press, clipped to its own shape, by taking the frame's pressed state. -->
        <LinearLayout
            android:id="@+id/chat_ask_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/chat_ask_why"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:contentDescription="@string/cd_chat_ask_why">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_ask_ai_chip"
                    android:duplicateParentState="true"
                    android:paddingStart="@dimen/space_s3"
                    android:paddingTop="@dimen/space_s1"
                    android:paddingEnd="@dimen/space_s3"
                    android:paddingBottom="@dimen/space_s1"
                    android:text="@string/chat_ask_chip_why"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_sm" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/chat_ask_what"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/ask_chip_gap"
                android:contentDescription="@string/cd_chat_ask_what">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_ask_ai_chip"
                    android:duplicateParentState="true"
                    android:paddingStart="@dimen/space_s3"
                    android:paddingTop="@dimen/space_s1"
                    android:paddingEnd="@dimen/space_s3"
                    android:paddingBottom="@dimen/space_s1"
                    android:text="@string/chat_ask_chip_what"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_sm" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/chat_ask_how"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/ask_chip_gap"
                android:contentDescription="@string/cd_chat_ask_how">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_ask_ai_chip"
                    android:duplicateParentState="true"
                    android:paddingStart="@dimen/space_s3"
                    android:paddingTop="@dimen/space_s1"
                    android:paddingEnd="@dimen/space_s3"
                    android:paddingBottom="@dimen/space_s1"
                    android:text="@string/chat_ask_chip_how"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_sm" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_composer_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_composer_inner"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_s3"
            android:paddingTop="@dimen/space_s2"
            android:paddingEnd="@dimen/space_s2"
            android:paddingBottom="@dimen/space_s2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/chat_draft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/chat_draft_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minHeight="@dimen/touch_min"
                    android:paddingStart="@dimen/space_s1"
                    android:paddingEnd="@dimen/space_s1"
                    android:textColor="@color/tl_ink"
                    android:textColorHint="@color/tl_ink3"
                    android:textSize="@dimen/text_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- T-077: the fullscreen editor's entry key (073 §5.1); greyed from the state
                         when the draft is empty, the branch is archived or the key is missing. -->
                    <ImageView
                        android:id="@+id/chat_expand"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="@string/cd_chat_fullscreen_edit"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chat_expand"
                        android:tint="@color/tl_ink3"
                        android:visibility="gone" />

                    <!-- The attachment entry as the design shot's pill; the paperclip stays the
                         face so the existing structural gate keeps reading it. 2026-09-28 user
                         decision: the pill was 44dp (touch_min) while the model chip beside it is
                         32dp, so the two read as different-height controls; the pill now sizes to
                         its content like the chip does, and the row still supplies the 44dp target.
                         2026-09-28 second decision: the paperclip was still a 24dp drawable while the
                         chip's bulb next to it draws at 15dp, so the pill stood a head taller and the
                         user marked the icon out ("附件图标大小减小"). The drawable is now bounded to
                         15dp at this usage site, matching the chip, and the trailing padding drops
                         from s3 to s2 so it mirrors the leading edge. -->
                    <TextView
                        android:id="@+id/chat_attach"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/tl_surface"
                        android:contentDescription="@string/cd_chat_attach"
                        android:drawableStart="@drawable/ic_chat_attach"
                        android:drawablePadding="@dimen/space_s1"
                        android:drawableTint="@color/tl_ink2"
                        android:foreground="@drawable/fg_pill_ripple"
                        android:gravity="center"
                        android:paddingStart="@dimen/space_s2"
                        android:paddingEnd="@dimen/space_s2"
                        android:text="@string/chat_attach_label"
                        android:textColor="@color/tl_ink2"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/chat_search_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s2"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/tl_surface"
                        android:contentDescription="@string/cd_chat_search_chip"
                        android:foreground="@drawable/fg_pill_ripple"
                        android:gravity="center"
                        android:minHeight="@dimen/touch_min"
                        android:paddingStart="@dimen/space_s3"
                        android:paddingEnd="@dimen/space_s3"
                        android:text="@string/chat_search_chip"
                        android:textColor="@color/tl_ink3"
                        android:textSize="@dimen/text_sm"
                        android:visibility="gone" />

                    <com.treelearn.app.screen.ModelThinkingPicker
                        android:id="@+id/chat_model_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s2" />

                    <ImageButton
                        android:id="@+id/chat_voice"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/space_s2"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="@string/cd_chat_voice"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chat_voice"
                        android:tint="@color/tl_ink2"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- The circular send (prototype .send-fab, line 140): the shared oval selector draws
                 the enabled/pressed/disabled steps, and the screen swaps the send/stop glyph.
                 2026-10-16: the Material Button's own elevation animator is off here too - the fab's
                 pressed step is drawn by its own selector, so the lift only made the key rock on its
                 axis while the card it sits in stayed flat. -->
            <Button
                android:id="@+id/chat_send"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/space_s2"
                android:background="@drawable/bg_send_fab"
                android:contentDescription="@string/cd_chat_send"
                android:drawableStart="@drawable/ic_chat_send"
                android:drawablePadding="0dp"
                android:drawableTint="@color/tl_surface"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@null"
                android:text=""
                android:textColor="@color/tl_surface"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
