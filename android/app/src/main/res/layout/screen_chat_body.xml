<?xml version="1.0" encoding="utf-8"?>
<!--
  The conversation column (technical design 13, Scheme A 2026-10-22): a capsule glass topbar, the
  glass reading panel, and the single-row dock composer pinned to the bottom.

  Every control that a state can disable carries an id so the screen can render it from one
  ChatViewState; nothing here holds a decision of its own.

  Scheme A's chat structure differs from the pre-2026-10-22 page in where things sit, not only in
  colour: the topbar is a floating capsule, the reader owns 15dp of inner padding, the actions are
  glass dots, the child branches are an inline stack inside the answer row (item_chat_message.xml),
  and the composer is one horizontal dock. The 44dp touch floor still wins over the proposal's
  38dp send and 29dp attachment keys; those faces sit inside the 44dp targets.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Scheme A's capsule topbar (.topbar): 52dp, 6dp below the status bar, 16dp from each side,
         8dp inner padding, 36dp keys drawing 20dp glyphs. 2026-10-25 (T-2026-10-25-096): the bar is
         back / title / more, three entries. The tree entry moved into the reading-area header's meta
         row, and the overview (tree map) and settings entries moved behind 更多; the user's review
         marked the four-icon bar as too dense and the board measures the title at 231dp instead of
         157dp once the two extra keys are gone. -->
    <LinearLayout
        android:id="@+id/chat_appbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:layout_marginStart="@dimen/space_s4"
        android:layout_marginTop="@dimen/topbar_offset"
        android:layout_marginEnd="@dimen/space_s4"
        android:background="@drawable/bg_glass_bar"
        android:elevation="@dimen/glass_capsule_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_s2">

        <ImageView
            android:id="@+id/chat_back"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_chat_back"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/tl_green_deep" />

        <TextView
            android:id="@+id/chat_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s1"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_topbar_title"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/chat_more"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_chat_more"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_more"
            android:tint="@color/tl_green_deep" />
    </LinearLayout>

    <!--
      The notice bar: one line for whatever category the presenter reported, hidden until there is
      something to tell. Its colour is set by NoticeText at draw time, because a note and a failure
      are not the same colour - so no colour belongs here, where a second one would be a second answer.
    -->
    <TextView
        android:id="@+id/chat_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chat_body_pad"
        android:layout_marginTop="@dimen/space_s2"
        android:layout_marginEnd="@dimen/chat_body_pad"
        android:textSize="@dimen/text_sm"
        android:visibility="gone" />

    <!--
      The glass reading panel. Scheme A gives it 12dp from the column, 10dp above the dock, 15dp
      inside, and a 28dp radius (bg_glass_reader). The flow and its floating "回到最新" button share
      one frame, so the button overlays the content and its appearing or disappearing can never move
      the composer's or the app bar's hit boxes (073 §4 总则).
    -->
    <FrameLayout
        android:id="@+id/chat_reader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/chat_body_pad"
        android:layout_marginTop="@dimen/chat_body_pad"
        android:layout_marginEnd="@dimen/chat_body_pad"
        android:layout_marginBottom="@dimen/chat_gap"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_reader">

        <com.treelearn.app.screen.FollowScrollView
            android:id="@+id/chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/reader_pad"
            android:paddingTop="@dimen/reader_pad"
            android:paddingEnd="@dimen/reader_pad"
            android:paddingBottom="@dimen/reader_pad_bottom">

        <!-- 2026-10-25 (T-2026-10-25-096): the branch's full title opens the reading area. The topbar
             keeps a 14sp single-line copy as sticky context (it must survive scrolling), and this is
             the whole one: 19sp serif, two lines on a phone. The meta row below carries the time once
             for the whole branch - the action row no longer repeats it per answer - and hands the
             tree entry its own 44dp cell on the right. -->
        <LinearLayout
            android:id="@+id/chat_reader_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/reader_header_gap"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_reader_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/noto_serif_sc"
                android:lineSpacingMultiplier="1.4"
                android:maxLines="2"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_reader_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chat_reader_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tl_ink3"
                    android:textSize="@dimen/text_cap" />

                <!-- The ghost key the board draws at .cghost: 44dp tall, negative vertical margins so
                     its extra height does not push the rule down, and only its 15dp glyph plus 12sp
                     label are visible. -->
                <LinearLayout
                    android:id="@+id/chat_branch_tree"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_s2"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/cd_chat_nav"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_s2"
                    android:paddingEnd="@dimen/space_s2">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_tree"
                        android:tint="@color/tl_green_deep" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s1"
                        android:text="@string/chat_branch_tree"
                        android:textColor="@color/tl_green_deep"
                        android:textSize="@dimen/text_cap"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginTop="@dimen/space_s2"
                android:background="@color/tl_line" />
        </LinearLayout>

        <!-- T-065: the source card of a non-root branch - collapsed to the summary line, the
             upstream history only after the learner opens it. Read-only: no row is tappable. -->
        <LinearLayout
            android:id="@+id/chat_source_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_s2"
            android:background="@color/tl_green_faint"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/chat_source_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:orientation="horizontal"
                android:paddingStart="@dimen/page_gutter"
                android:paddingTop="@dimen/space_s2"
                android:paddingEnd="@dimen/page_gutter"
                android:paddingBottom="@dimen/space_s2">

                <TextView
                    android:id="@+id/chat_source_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_s2"
                    android:text="@string/source_card_title"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_cap"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chat_source_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/tl_ink2"
                    android:textSize="@dimen/text_cap" />

                <TextView
                    android:id="@+id/chat_source_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s2"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_cap" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chat_source_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_s2"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/chat_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s4"
                android:text="@string/chat_loading"
                android:textColor="@color/tl_ink3"
                android:textSize="@dimen/text_sm"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chat_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s4"
                android:text="@string/chat_error"
                android:textColor="@color/tl_red"
                android:textSize="@dimen/text_sm"
                android:visibility="gone" />


        </LinearLayout>
        </com.treelearn.app.screen.FollowScrollView>

        <!-- T-075: the follow-latest key (073 §6). 2026-10-16 user decision: it was a text pill, so it
             grew wider every time a missed item joined the label ("这个背景太傻大了", and nothing stays
             fixed when its own width keeps changing). It is now a fixed 44dp rounded rectangle holding
             one down chevron, and the count rides a badge in the corner the way the answer row's child
             entry already does it. The slot is what floats (gravity bottom|center over the scroll
             region); the key inside never resizes. The slot is also the only visibility switch - the
             key is always visible inside it, so a hidden key and a hidden slot can never disagree. -->
        <FrameLayout
            android:id="@+id/chat_follow_slot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/space_s3"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/chat_follow"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_follow_latest"
                android:contentDescription="@string/chat_back_to_latest"
                android:elevation="@dimen/space_s1"
                android:scaleType="center"
                android:src="@drawable/ic_chevron_down"
                android:stateListAnimator="@null"
                android:tint="@color/tl_action_text" />

            <!-- The missed count, decor: the key's content description already names it, so a screen
                 reader must not read the number twice. -->
            <TextView
                android:id="@+id/chat_follow_count"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_count_badge"
                android:elevation="@dimen/space_s1"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="14dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:textColor="@color/tl_surface"
                android:textSize="9.5sp"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <!-- The quoted sentence the next question will be asked from. -->
    <LinearLayout
        android:id="@+id/chat_quote_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chat_body_pad"
        android:layout_marginEnd="@dimen/chat_body_pad"
        android:background="@color/tl_green_faint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/space_s2"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_quote_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="@dimen/space_s2"
            android:paddingBottom="@dimen/space_s2"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_sm" />

        <ImageView
            android:id="@+id/chat_quote_clear"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_chat_quote_clear"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chat_close"
            android:tint="@color/tl_ink2" />
    </LinearLayout>

    <!-- The attachment the next question will carry (T-097); mutually exclusive with the quote
         row, which is the presenter's decision, so at most one of the two rows shows at a time. -->
    <LinearLayout
        android:id="@+id/chat_attach_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chat_body_pad"
        android:layout_marginEnd="@dimen/chat_body_pad"
        android:background="@color/tl_green_faint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/space_s2"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_attach_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="@dimen/space_s2"
            android:paddingBottom="@dimen/space_s2"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_sm" />

        <ImageView
            android:id="@+id/chat_attach_clear"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_chat_attachment_remove"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chat_close"
            android:tint="@color/tl_ink2" />
    </LinearLayout>

    <!-- Scheme A's dock (the composer dock): one glass row - paperclip, draft, model chip, send -
         14/11/12/11 padding and a 24dp radius. The paperclip and send keep 44dp targets; only
         their faces follow the proposal. -->
    <LinearLayout
        android:id="@+id/chat_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:paddingStart="@dimen/chat_body_pad"
        android:paddingEnd="@dimen/chat_body_pad"
        android:paddingBottom="@dimen/chat_body_bottom">

        <!-- 2026-09-28 user decision: after 问 AI picks the selection, three one-tap queries show
             here - above the dock, inside the composer column. Each chip sends its query as-is
             (the draft is kept) and the row collapses on send, so the frames exist to be tapped
             once. The visible pill is the model chip's class; the 44dp hot zone is the hosting
             frame, the split ModelThinkingPicker already uses. -->
        <LinearLayout
            android:id="@+id/chat_ask_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_s2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/chat_ask_why"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:contentDescription="@string/cd_chat_ask_why">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_ask_ai_chip"
                    android:duplicateParentState="true"
                    android:paddingStart="@dimen/space_s3"
                    android:paddingTop="@dimen/space_s1"
                    android:paddingEnd="@dimen/space_s3"
                    android:paddingBottom="@dimen/space_s1"
                    android:text="@string/chat_ask_chip_why"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_sm" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/chat_ask_what"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/ask_chip_gap"
                android:contentDescription="@string/cd_chat_ask_what">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_ask_ai_chip"
                    android:duplicateParentState="true"
                    android:paddingStart="@dimen/space_s3"
                    android:paddingTop="@dimen/space_s1"
                    android:paddingEnd="@dimen/space_s3"
                    android:paddingBottom="@dimen/space_s1"
                    android:text="@string/chat_ask_chip_what"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_sm" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/chat_ask_how"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/ask_chip_gap"
                android:contentDescription="@string/cd_chat_ask_how">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_ask_ai_chip"
                    android:duplicateParentState="true"
                    android:paddingStart="@dimen/space_s3"
                    android:paddingTop="@dimen/space_s1"
                    android:paddingEnd="@dimen/space_s3"
                    android:paddingBottom="@dimen/space_s1"
                    android:text="@string/chat_ask_chip_how"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_sm" />
            </FrameLayout>
        </LinearLayout>

        <!--
          2026-10-23 (T-066): the dock grew a second line. The model chip and the new persona chip
          share the tools line, so the draft keeps the whole input line on a 360dp screen instead of
          splitting it with two chips; the glass card, radii and 14/11/12/11 padding are unchanged.
        -->
        <LinearLayout
            android:id="@+id/chat_composer_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_dock"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/dock_pad_start"
            android:paddingTop="@dimen/dock_pad"
            android:paddingEnd="@dimen/dock_pad_end"
            android:paddingBottom="@dimen/dock_pad">

            <LinearLayout
                android:id="@+id/chat_composer_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/chat_attach"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/cd_chat_attach"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chat_attach"
                    android:tint="@color/tl_ink2" />

                <!-- T-077: the fullscreen editor's entry key; greyed from the state when the draft is
                     empty, the branch is archived or the key is missing. Hidden this round, kept under
                     its id so the state binding and the layout contract do not drift. -->
                <ImageView
                    android:id="@+id/chat_expand"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/cd_chat_fullscreen_edit"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chat_expand"
                    android:tint="@color/tl_ink3"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/chat_draft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/chat_draft_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minHeight="@dimen/touch_min"
                    android:paddingStart="@dimen/space_s1"
                    android:paddingEnd="@dimen/space_s1"
                    android:textColor="@color/tl_ink"
                    android:textColorHint="@color/tl_ink3"
                    android:textSize="@dimen/text_chat_user" />

                <!-- The circular send (prototype .send-fab): the shared oval selector draws the
                     enabled/pressed/disabled steps, and the screen swaps the send/stop glyph. The
                     Material Button's own elevation animator is off: the fab's pressed step is drawn
                     by its selector, so the lift only made the key rock on its axis. -->
                <Button
                    android:id="@+id/chat_send"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/dock_gap"
                    android:background="@drawable/bg_send_fab"
                    android:contentDescription="@string/cd_chat_send"
                    android:drawableStart="@drawable/ic_chat_send"
                    android:drawablePadding="0dp"
                    android:drawableTint="@color/tl_surface"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:stateListAnimator="@null"
                    android:text=""
                    android:textColor="@color/tl_surface"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chat_composer_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.treelearn.app.screen.ModelThinkingPicker
                    android:id="@+id/chat_model_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.treelearn.app.screen.PersonaPicker
                    android:id="@+id/chat_persona_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dock_gap" />

                <TextView
                    android:id="@+id/chat_search_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s2"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/tl_surface"
                    android:contentDescription="@string/cd_chat_search_chip"
                    android:foreground="@drawable/fg_pill_ripple"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_min"
                    android:paddingStart="@dimen/space_s3"
                    android:paddingEnd="@dimen/space_s3"
                    android:text="@string/chat_search_chip"
                    android:textColor="@color/tl_ink3"
                    android:textSize="@dimen/text_sm"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/chat_voice"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/dock_gap"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/cd_chat_voice"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chat_voice"
                    android:tint="@color/tl_ink2"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
