<?xml version="1.0" encoding="utf-8"?>
<!--
  The settings column itself, shared verbatim by the phone layout and the tablet layout.

  Settings redesign (2026-09-28, scheme C): the page is a pure grouped navigation list. The key
  card moved out to its own room (screen_settings_key_body.xml) and survives here only as the
  "API KEY" entry row whose subtitle carries the credential's live state. Two flush group cards
  hold the entries, rows separated by hairlines, and every disclosure chevron is ic_chevron_right
  per the prototype review's M6 ruling.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_s8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_s4"
            android:paddingEnd="@dimen/page_gutter">

            <ImageView
                android:id="@+id/settings_back"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="-8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_settings_back"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_back"
                android:tint="@color/tl_green_deep" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s2"
                android:text="@string/settings_title"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_h1"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_s6"
            android:paddingEnd="@dimen/page_gutter"
            android:text="@string/settings_group_ai"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_cap" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="@dimen/space_s2"
            android:layout_marginEnd="@dimen/page_gutter"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical">

            <!-- T-087 kept its entry row; the key room entry sits in front of it. -->
            <LinearLayout
                android:id="@+id/settings_key_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:orientation="horizontal"
                android:padding="@dimen/space_s4">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_key_entry_title"
                        android:textColor="@color/tl_ink"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/settings_key_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_key_state_none"
                        android:textColor="@color/tl_ink3"
                        android:textSize="@dimen/text_cap" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_key_entry_title"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/tl_ink3" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:background="@color/tl_line" />

            <LinearLayout
                android:id="@+id/settings_providers_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:orientation="horizontal"
                android:padding="@dimen/space_s4">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/providers_entry_title"
                        android:textColor="@color/tl_ink"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/settings_providers_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/providers_entry_sub"
                        android:textColor="@color/tl_ink3"
                        android:textSize="@dimen/text_cap" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/providers_entry_title"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/tl_ink3" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:background="@color/tl_line" />

            <LinearLayout
                android:id="@+id/settings_models_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:orientation="horizontal"
                android:padding="@dimen/space_s4">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/models_entry_title"
                        android:textColor="@color/tl_ink"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/settings_models_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/models_entry_sub"
                        android:textColor="@color/tl_ink3"
                        android:textSize="@dimen/text_cap" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/models_entry_title"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/tl_ink3" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_s6"
            android:paddingEnd="@dimen/page_gutter"
            android:text="@string/settings_group_capability"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_cap" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="@dimen/space_s2"
            android:layout_marginEnd="@dimen/page_gutter"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical">

            <!-- T-091: the search service entry, next to the model entry. -->
            <LinearLayout
                android:id="@+id/settings_search_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:orientation="horizontal"
                android:padding="@dimen/space_s4">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/search_entry_title"
                        android:textColor="@color/tl_ink"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/search_entry_sub"
                        android:textColor="@color/tl_ink3"
                        android:textSize="@dimen/text_cap" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/search_entry_title"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/tl_ink3" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:background="@color/tl_line" />

            <!-- T-093: the voice entry, next to the search entry. -->
            <LinearLayout
                android:id="@+id/settings_voice_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:orientation="horizontal"
                android:padding="@dimen/space_s4">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_entry_title"
                        android:textColor="@color/tl_ink"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_entry_sub"
                        android:textColor="@color/tl_ink3"
                        android:textSize="@dimen/text_cap" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/voice_entry_title"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/tl_ink3" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:background="@color/tl_line" />

            <!-- T-096: the file manager entry, next to the voice entry. -->
            <LinearLayout
                android:id="@+id/settings_files_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:orientation="horizontal"
                android:padding="@dimen/space_s4">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_files_title"
                        android:textColor="@color/tl_ink"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_files_sub"
                        android:textColor="@color/tl_ink3"
                        android:textSize="@dimen/text_cap" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_files_title"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/tl_ink3" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_s6"
            android:paddingEnd="@dimen/page_gutter"
            android:text="@string/settings_boundary_title"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_cap" />

        <TextView
            android:id="@+id/settings_boundary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.4"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_s2"
            android:paddingEnd="@dimen/page_gutter"
            android:text="@string/settings_boundary_body"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>
