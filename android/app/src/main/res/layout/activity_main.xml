<?xml version="1.0" encoding="utf-8"?>
<!--
  The app shell: one Activity, one host, screens swapped into it (PRD 6.2.16 keeps a single entry
  page; the conversation, canvas and search screens arrive in later tasks and are added by swapping
  the host's child, not by adding Activities).

  `main_root` is kept from the T-002 skeleton because the launch test finds it by that id.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tl_bg">

    <FrameLayout
        android:id="@+id/shell_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>