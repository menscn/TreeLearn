<?xml version="1.0" encoding="utf-8"?>
<!--
  The home page as Scheme A draws it (2026-10-22): the large serif brand lockup with its sans
  subtitle, the tall glass composer, recommendations and history. The column stacks from the top and
  the order is the proposal's own - brand, composer, recommendations, history.

  The glass capsule topbar is not in this column: since 2026-10-23-075 it floats over the scroll
  container in layout/screen_home.xml, so it stays on screen while this column moves under it. That
  is why this file starts at the brand and why the scroll container carries @dimen/top_bar_clearance.

  The subtitle is always shown since Scheme A always shows it. It keeps the `home_hero_title` id and
  the existing copy (the 2026-10-22 decision changed placement, not wording); only its type changed
  from a serif headline to the proposal's 12sp sans line.

  The topbar carries no attachment entry: since 2026-10-22 the home has no end-to-end path from a
  draft to a first-message attachment, and the user's rule is to delete an entry that cannot reach
  real data rather than leave a button that does nothing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_s2">

    <LinearLayout
        android:id="@+id/home_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_s4"
        android:paddingTop="@dimen/home_body_top"
        android:paddingEnd="@dimen/space_s4"
        android:paddingBottom="@dimen/space_s4">

        <LinearLayout
            android:id="@+id/home_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/home_brand_top"
            android:paddingBottom="@dimen/home_brand_bottom">

            <LinearLayout
                android:id="@+id/home_brand_lockup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/home_brand_mark"
                    android:layout_width="@dimen/brand_mark_size"
                    android:layout_height="@dimen/brand_mark_size"
                    android:contentDescription="@string/cd_home_brand"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_brand_sprout" />

                <!-- The height is the proposal's line-height: 1, not wrap_content: the bundled
                     serif's 2.858em CFF line box otherwise pushes the subtitle 52dp down
                     (2026-10-22 walkthrough). WordmarkTextView centres the font box in this frame. -->
                <com.treelearn.app.screen.WordmarkTextView
                    android:id="@+id/home_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/brand_line_height"
                    android:layout_marginStart="@dimen/space_s3"
                    android:fontFamily="@font/noto_serif_sc"
                    android:letterSpacing="0.06"
                    android:text="@string/app_name"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_brand"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s3"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:lineSpacingMultiplier="1.6"
                android:text="@string/home_hero_title"
                android:textAlignment="center"
                android:textColor="@color/tl_ink2"
                android:textSize="@dimen/text_home_sub" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_composer"
            android:elevation="@dimen/card_elevation"
            android:minHeight="@dimen/composer_min_height"
            android:orientation="vertical"
            android:paddingStart="@dimen/composer_pad"
            android:paddingTop="@dimen/composer_pad"
            android:paddingEnd="@dimen/composer_pad"
            android:paddingBottom="@dimen/composer_pad_bottom">

            <com.treelearn.app.screen.RuleEditText
                android:id="@+id/home_draft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/home_draft_hint"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColor="@color/tl_ink"
                android:textColorHint="@color/tl_ink3"
                android:textSize="@dimen/text_composer" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/composer_row_top"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 2026-09-28 user decision: the key-state pill (未配置 Key / DeepSeek 已就绪) is
                     removed from the composer's foot. It repeated what the settings page already
                     says, and it made the composer's foot look busier than the design does. The
                     model chip now leads the row; the settings key card remains the one surface
                     that reports the key's state. -->

                <com.treelearn.app.screen.ModelThinkingPicker
                    android:id="@+id/home_model_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- The send control keeps the project's 44dp touch minimum; Scheme A draws a 40dp
                     circle, and shrinking to it would put the one irreversible action below the
                     repository's accessibility floor. The 4dp difference is registered in 055. -->
                <ImageButton
                    android:id="@+id/home_send"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_send_fab"
                    android:contentDescription="@string/home_send"
                    android:enabled="false"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chat_send"
                    android:tint="@color/tl_surface" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2026-09-28 user decision: the strip now sits space_s4 (16dp) under the composer.
             Three layers disagree here, which is why this carries a note:
               - the prototype's .rec-block is padding:4px 0 6px with no margin of its own, i.e. it
                 sits almost flush under the input card (Docs/04-ux-design/...-v1.1.html line 360);
               - the home visual spec's token matrix maps .rec-block to space_s4 without saying
                 whether that is padding or margin (Docs/spec/SPEC-2026-09-27-home-visual-fidelity.md
                 line 52), and its value does not appear anywhere in the prototype's own rule;
               - the Android build had implemented 8dp (space_s2 on the marquee alone) and the
                 learner reported it as too tight.
             This line takes the spec's own number, which the learner's walkthrough independently
             asked for. It is a departure from the prototype, not a fidelity gap - and it is NOT the
             prototype's 4px. Do not "fix" it back to 4px or 8dp without asking. -->
        <LinearLayout
            android:id="@+id/home_recommendations_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s4"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- The prototype's .rec-head: a sparkle and a short heading, both in the secondary/cap size
                 band. The heading's text is set from HomeScreen, because it is one of two strings
                 (试试这些起点 / 猜你想学) chosen by the same hasTopics() judgement the hero reads. -->
            <LinearLayout
                android:id="@+id/home_recommendations_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/home_recommendations_sparkle"
                    android:layout_width="@dimen/space_s4"
                    android:layout_height="@dimen/space_s4"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    android:tint="@color/tl_ink3" />

                <TextView
                    android:id="@+id/home_recommendations_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s1"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_cap"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.treelearn.app.screen.RecommendationMarquee
                android:id="@+id/home_recommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_recent_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s4"
            android:orientation="vertical">

            <!-- The prototype's .home-sec: a short heading and a count on one baseline, the count
                 empty while there is nothing to count. The horizontal gutter comes from home_primary,
                 which already carries the body gutter for the whole column. -->
            <LinearLayout
                android:id="@+id/home_recent_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/home_recent_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_recent_title"
                    android:textColor="@color/tl_ink"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_recent_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s2"
                    android:textColor="@color/tl_ink3"
                    android:textSize="@dimen/text_cap"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The prototype's .home-empty. Its "browse the sample topic" link is not carried over:
                 the app has no sample-topic generator, and the deviation is registered in the spec. -->
            <TextView
                android:id="@+id/home_topics_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s6"
                android:gravity="center"
                android:lineSpacingMultiplier="1.9"
                android:text="@string/home_topics_empty"
                android:textColor="@color/tl_ink3"
                android:textSize="@dimen/text_sm"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/home_recent_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s2"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <!-- One line for whatever category the presenter reported; NoticeText sets its colour at
             draw time, so no colour is declared here. -->
        <TextView
            android:id="@+id/home_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s2"
            android:textSize="@dimen/text_sm"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
