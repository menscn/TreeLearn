<?xml version="1.0" encoding="utf-8"?>
<!--
  The home column itself. The phone layout and the tablet layout both include it, so the two
  configurations cannot drift; only the width that surrounds it differs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_s8">

        <!-- Brand bar: 搜索 / 归档 / 设置 live here (PRD 6.2.16 point 1). -->
        <LinearLayout
            android:id="@+id/home_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_s4"
            android:paddingEnd="@dimen/page_gutter">

            <TextView
                android:id="@+id/home_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_h1"
                android:textStyle="bold" />

            <Button
                android:id="@+id/home_search"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:minWidth="@dimen/touch_min"
                android:text="@string/action_search"
                android:textColor="@color/tl_ink3"
                android:textSize="@dimen/text_sm" />

            <Button
                android:id="@+id/home_archived"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:minWidth="@dimen/touch_min"
                android:text="@string/action_archived"
                android:textColor="@color/tl_ink3"
                android:textSize="@dimen/text_sm" />

            <Button
                android:id="@+id/home_settings"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:minWidth="@dimen/touch_min"
                android:text="@string/action_settings"
                android:textColor="@color/tl_green_deep"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>

        <!-- Hero copy: only while there is no topic yet (PRD 6.2.16 example 1). -->
        <LinearLayout
            android:id="@+id/home_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_s4"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingBottom="@dimen/space_s6">

            <TextView
                android:id="@+id/home_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/home_hero_title"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_display" />

            <TextView
                android:id="@+id/home_hero_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s2"
                android:text="@string/home_hero_sub"
                android:textColor="@color/tl_ink2"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>

        <!-- Root-question composer: always present, draft survives every failure. -->
        <LinearLayout
            android:id="@+id/home_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginEnd="@dimen/page_gutter"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical"
            android:padding="@dimen/space_s4">

            <EditText
                android:id="@+id/home_draft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/home_draft_hint"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:textColor="@color/tl_ink"
                android:textColorHint="@color/tl_ink3"
                android:textSize="@dimen/text_body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.treelearn.app.screen.ModelThinkingPicker
                    android:id="@+id/home_model_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/home_key_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s2"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/tl_amber_soft"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/space_s3"
                    android:paddingTop="@dimen/space_s1"
                    android:paddingEnd="@dimen/space_s3"
                    android:paddingBottom="@dimen/space_s2"
                    android:text="@string/home_key_missing"
                    android:textColor="@color/tl_amber"
                    android:textSize="@dimen/text_cap" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/home_send"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_button_primary"
                    android:enabled="false"
                    android:minWidth="@dimen/touch_min"
                    android:text="@string/home_send"
                    android:textColor="@color/tl_surface"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/home_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="@dimen/space_s3"
            android:layout_marginEnd="@dimen/page_gutter"
            android:textColor="@color/tl_red"
            android:textSize="@dimen/text_sm"
            android:visibility="gone" />

        <com.treelearn.app.screen.RecommendationMarquee
            android:id="@+id/home_recommendations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s4"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_s6"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingBottom="@dimen/space_s3">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_section_topics"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_section_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s2"
                android:textColor="@color/tl_ink3"
                android:textSize="@dimen/text_cap" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_topics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter" />

        <TextView
            android:id="@+id/home_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_s3"
            android:paddingEnd="@dimen/page_gutter"
            android:text="@string/home_loading"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_sm"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_s3"
            android:paddingEnd="@dimen/page_gutter"
            android:text="@string/home_error"
            android:textColor="@color/tl_red"
            android:textSize="@dimen/text_sm"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingBottom="@dimen/space_s4">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_empty_topics"
                android:textColor="@color/tl_ink3"
                android:textSize="@dimen/text_sm" />

            <Button
                android:id="@+id/home_empty_guide"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_s1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:minWidth="@dimen/touch_min"
                android:text="@string/home_empty_guide"
                android:textColor="@color/tl_green_deep"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>
    </LinearLayout>
