<?xml version="1.0" encoding="utf-8"?>
<!--
  The home page as the prototype draws it (T-003): the column stacks from the top instead of centring
  a group, and the order is the prototype's own - appbar, brand lockup with the empty-state slogan,
  composer, recommendations, history. The brand lockup is a horizontal "sprout + 知芽"; the slogan is
  shown only while the home has no history topics (HomeViewState.hasTopics, read by HomeScreen).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_s2">

    <LinearLayout
        android:id="@+id/home_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_s4"
        android:paddingEnd="@dimen/page_gutter">

        <ImageView
            android:id="@+id/home_drawer_button"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="-8dp"
            android:contentDescription="@string/cd_home_drawer"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_menu"
            android:tint="@color/tl_ink2" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingBottom="@dimen/space_s4">

        <LinearLayout
            android:id="@+id/home_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_s4"
            android:paddingBottom="@dimen/space_s6">

            <LinearLayout
                android:id="@+id/home_brand_lockup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_s2"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/home_brand_mark"
                    android:layout_width="@dimen/brand_mark_size"
                    android:layout_height="@dimen/brand_mark_size"
                    android:contentDescription="@string/cd_home_brand"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_brand_sprout" />

                <TextView
                    android:id="@+id/home_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s2"
                    android:fontFamily="serif"
                    android:text="@string/app_name"
                    android:textColor="@color/tl_ink"
                    android:textSize="@dimen/text_brand"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/home_hero_title"
                android:textAlignment="center"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_h1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical"
            android:padding="@dimen/space_s4">

            <com.treelearn.app.screen.RuleEditText
                android:id="@+id/home_draft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/home_draft_hint"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColor="@color/tl_ink"
                android:textColorHint="@color/tl_ink3"
                android:textSize="@dimen/text_body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.treelearn.app.screen.ModelThinkingPicker
                    android:id="@+id/home_model_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/home_key_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s2"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/tl_amber_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_s3"
                    android:paddingTop="@dimen/space_s1"
                    android:paddingEnd="@dimen/space_s3"
                    android:paddingBottom="@dimen/space_s1">

                    <ImageView
                        android:id="@+id/home_key_icon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_key"
                        android:tint="@color/tl_amber" />

                    <TextView
                        android:id="@+id/home_key_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s1"
                        android:text="@string/home_key_missing"
                        android:textColor="@color/tl_amber"
                        android:textSize="@dimen/text_cap" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/home_send"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_send_fab"
                    android:contentDescription="@string/home_send"
                    android:enabled="false"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chat_send"
                    android:tint="@color/tl_surface" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_recommendations_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- The prototype's .rec-head: a sparkle and a short heading, both in the secondary/cap size
                 band. The heading's text is set from HomeScreen, because it is one of two strings
                 (试试这些起点 / 猜你想学) chosen by the same hasTopics() judgement the hero reads. -->
            <LinearLayout
                android:id="@+id/home_recommendations_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/home_recommendations_sparkle"
                    android:layout_width="@dimen/space_s4"
                    android:layout_height="@dimen/space_s4"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    android:tint="@color/tl_ink3" />

                <TextView
                    android:id="@+id/home_recommendations_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s1"
                    android:textColor="@color/tl_green_deep"
                    android:textSize="@dimen/text_cap"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.treelearn.app.screen.RecommendationMarquee
                android:id="@+id/home_recommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_recent_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s6"
            android:orientation="vertical">

            <!-- The prototype's .home-sec: a short heading and a count on one baseline, the count
                 empty while there is nothing to count. The horizontal gutter comes from home_primary,
                 which already carries page_gutter for the whole column. -->
            <LinearLayout
                android:id="@+id/home_recent_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/home_recent_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_recent_title"
                    android:textColor="@color/tl_ink"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_recent_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s2"
                    android:textColor="@color/tl_ink3"
                    android:textSize="@dimen/text_cap"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The prototype's .home-empty. Its "browse the sample topic" link is not carried over:
                 the app has no sample-topic generator, and the deviation is registered in the spec. -->
            <TextView
                android:id="@+id/home_topics_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s6"
                android:gravity="center"
                android:lineSpacingMultiplier="1.9"
                android:text="@string/home_topics_empty"
                android:textColor="@color/tl_ink3"
                android:textSize="@dimen/text_sm"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/home_recent_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s3"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s2"
            android:textColor="@color/tl_red"
            android:textSize="@dimen/text_sm"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
