<?xml version="1.0" encoding="utf-8"?>
<!--
  Phone canvas: one column, full width (PRD 6.2.16: the phone is single-column). The column itself
  lives in screen_tree_body.xml so the phone and the tablet cannot drift apart.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tree_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/screen_tree_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>