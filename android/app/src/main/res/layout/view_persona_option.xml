<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the persona popover: the prototype's .popover-item - a 44dp target that keeps the
  platform ripple, the name with its short tag, and the check that marks the stored style. The row
  is inflated once per enum value by PersonaPicker, so there is no seven-block XML to drift.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/persona_option"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_persona_option"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_s3"
    android:paddingTop="@dimen/space_s2"
    android:paddingEnd="@dimen/space_s3"
    android:paddingBottom="@dimen/space_s2">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/persona_option_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/persona_option_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s2"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/tl_bg"
            android:paddingStart="@dimen/space_s2"
            android:paddingTop="1dp"
            android:paddingEnd="@dimen/space_s2"
            android:paddingBottom="1dp"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_cap" />
    </LinearLayout>

    <ImageView
        android:id="@+id/persona_option_check"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="@dimen/space_s2"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check"
        android:tint="@color/tl_green"
        android:visibility="invisible" />
</LinearLayout>
