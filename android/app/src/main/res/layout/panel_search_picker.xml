<?xml version="1.0" encoding="utf-8"?>
<!--
  T-092: the search chip's bottom panel (SPEC-2026-09-23 拍板 4, RikkaHub SearchPicker 形态):
  the switch, the selected engine and the jump to the search service page. Every row is a plain
  TextView with a 44dp hot zone; the panel draws from the rendered state and decides nothing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tl_surface"
    android:orientation="vertical"
    android:padding="@dimen/page_gutter">

    <TextView
        android:id="@+id/search_panel_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_panel_title"
        android:textColor="@color/tl_ink"
        android:textSize="@dimen/text_h2"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/search_panel_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s3"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:textColor="@color/tl_green_deep"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/search_panel_engine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:textColor="@color/tl_ink2"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/search_panel_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:text="@string/search_panel_go_settings"
        android:textColor="@color/tl_green_deep"
        android:textSize="@dimen/text_body" />
</LinearLayout>
