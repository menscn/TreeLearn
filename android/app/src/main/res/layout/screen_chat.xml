<?xml version="1.0" encoding="utf-8"?>
<!--
  Phone conversation: one column, full width. The column itself lives in screen_chat_body.xml so the
  phone and the tablet cannot drift apart; only the width that surrounds it differs.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/screen_chat_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- T-077: the fullscreen editor (073 §5.1) - an overlay over the column, on phone and tablet
         alike; it covers the composer without moving it. -->
    <include
        layout="@layout/overlay_fullscreen_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>