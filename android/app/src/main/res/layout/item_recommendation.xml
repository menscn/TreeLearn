<?xml version="1.0" encoding="utf-8"?>
<!--
  One recommendation chip: the prototype's .rec-chip
  (Docs/04-ux-design/知芽-TreeLearn-高保真原型-v1.html line 350), three parts left to right - the category
  pill, the question, and a trailing chevron.

  Two things this markup deliberately does not decide:

  * The tag's colours. They are per kind, and that judgement lives in RecommendationTag, so the markup
    carries neither a backgroundTint nor a textColor for the tag. Pinning either one here would give all
    three categories the same tier and silently undo the judgement.
  * The chevron's meaning. It is decoration on a chip whose whole surface sends the question as the root
    question (PRD 6.2.17 point 4); it is not a second, smaller target that opens a detail page.

  The chip's height is @dimen/touch_min rather than the prototype's ~33px, because the chip IS the tap
  target here. That deviation is registered in the parent spec's deviation table.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rec_chip"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/touch_min"
    android:layout_marginEnd="@dimen/space_s2"
    android:background="@drawable/bg_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_s3"
    android:paddingEnd="@dimen/space_s3">

    <TextView
        android:id="@+id/rec_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill"
        android:importantForAccessibility="no"
        android:paddingStart="@dimen/space_s2"
        android:paddingTop="@dimen/space_s1"
        android:paddingEnd="@dimen/space_s2"
        android:paddingBottom="@dimen/space_s1"
        android:textSize="@dimen/text_cap" />

    <TextView
        android:id="@+id/rec_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s2"
        android:importantForAccessibility="no"
        android:maxWidth="@dimen/rec_text_max"
        android:textColor="@color/tl_ink"
        android:textSize="@dimen/text_sm" />

    <ImageView
        android:id="@+id/rec_chevron"
        android:layout_width="@dimen/space_s3"
        android:layout_height="@dimen/space_s3"
        android:layout_marginStart="@dimen/space_s2"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/tl_ink" />
</LinearLayout>
