<?xml version="1.0" encoding="utf-8"?>
<!-- One recommendation chip. A tap sends it as the root question, so the chip's own height and the
     tag are both part of the tap target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rec_chip"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/touch_min"
    android:layout_marginEnd="@dimen/space_s2"
    android:background="@drawable/bg_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_s3"
    android:paddingEnd="@dimen/space_s3">

    <TextView
        android:id="@+id/rec_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/tl_green_soft"
        android:paddingStart="@dimen/space_s2"
        android:paddingTop="@dimen/space_s1"
        android:paddingEnd="@dimen/space_s2"
        android:paddingBottom="@dimen/space_s1"
        android:textColor="@color/tl_green_deep"
        android:textSize="@dimen/text_cap" />

    <TextView
        android:id="@+id/rec_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s2"
        android:maxWidth="@dimen/rec_text_max"
        android:textColor="@color/tl_ink"
        android:textSize="@dimen/text_sm" />
</LinearLayout>