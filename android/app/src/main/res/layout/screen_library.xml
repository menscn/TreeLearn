<?xml version="1.0" encoding="utf-8"?>
<!--
  Phone library: one column, full width. The column itself lives in screen_library_body.xml, so the
  phone page and the tablet page cannot drift; only the width that surrounds it differs.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/library_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <include
        layout="@layout/screen_library_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</ScrollView>
