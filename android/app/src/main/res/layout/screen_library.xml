<?xml version="1.0" encoding="utf-8"?>
<!--
  Phone library: the same column as the home, wrapped the same way. The column itself lives in
  screen_library_body.xml, so the phone page and the tablet page cannot drift; only the width that
  surrounds it differs.

  Like the home, this page pays both floating capsules' room in its own scroll container with
  clipToPadding off (T-2026-10-22-062 for the bottom, T-2026-10-23-075 for the top), so topic rows
  pass under the glass instead of stopping above it. The topbar used to be the column's first row and
  scrolled away with it; it is the page's only back entry and its title, so pinning it is what keeps
  the learner oriented mid-list. See layout/screen_home.xml for why the host holds no padding.

  `library_root` keeps its id and stays the scroll container: the shell tests find the page by it.
  `clipChildren` is off on the wrapper for the same reason the shell's is - an elevation shadow is
  drawn by the parent.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/library_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ScrollView
        android:id="@+id/library_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/tab_bar_clearance"
        android:paddingTop="@dimen/top_bar_clearance">

        <include
            layout="@layout/screen_library_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/library_appbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/space_s4"
        android:layout_marginTop="@dimen/topbar_offset"
        android:layout_marginEnd="@dimen/space_s4"
        android:background="@drawable/bg_glass_control_bar"
        android:elevation="@dimen/glass_capsule_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s2"
        android:paddingEnd="@dimen/space_s2">

        <ImageView
            android:id="@+id/library_back"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_library_back"
            android:padding="@dimen/space_s2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/tl_ink2" />

        <TextView
            android:id="@+id/library_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s2"
            android:fontFamily="@font/noto_serif_sc"
            android:letterSpacing="0.02"
            android:text="@string/library_title"
            android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_library_title"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

