<?xml version="1.0" encoding="utf-8"?>
<!--
  Phone home: one column, full width. The column itself lives in screen_home_body.xml.

  Both floating capsules belong to this file, not to the column: the page pays their room in its own
  scroll container (@dimen/tab_bar_clearance below and @dimen/top_bar_clearance above) with
  clipToPadding off, so rows travel under the glass while the page moves and still come to rest whole
  above them at the end of the scroll. Before T-2026-10-22-062 the host held the bottom padding
  instead, which ended the viewport above the capsule and left the translucent face with nothing to be
  translucent over. The topbar joined it on 2026-10-23-075: it used to be the column's first row, so
  it scrolled away with the brand and the learner lost the two entries they had just been using. The
  proposal sheet already pins it - `_src/screens/home.html` puts `<header class="topbar glass">`
  beside `.app-body`, and glass.css gives it `flex: none` - and so does the Web workspace
  (`.workspace-topbar`, position absolute + a padding-top on the scroll container). The floating
  placement is the design fact Android had diverged from, not a new idea.

  `clipChildren` is off for the same reason the shell's is: an elevation shadow is drawn by the
  parent, and clipping the capsule to its own bounds is what left the floating bar with no
  projection at all (T-2026-10-22-061).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ScrollView
        android:id="@+id/home_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/tab_bar_clearance"
        android:paddingTop="@dimen/top_bar_clearance">

        <include
            layout="@layout/screen_home_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/home_appbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/space_s4"
        android:layout_marginTop="@dimen/topbar_offset"
        android:layout_marginEnd="@dimen/space_s4"
        android:background="@drawable/bg_glass_control_bar"
        android:elevation="@dimen/glass_capsule_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s2"
        android:paddingEnd="@dimen/space_s2">

        <ImageView
            android:id="@+id/home_drawer_button"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_home_drawer"
            android:padding="@dimen/space_s2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_menu"
            android:tint="@color/tl_ink2" />

        <!-- 2026-10-25 (T-2026-10-25-100): the brand lockup moved up from the column's first row into
             this bar. The board's home is a short bar - menu, wordmark, gear - and a 22sp serif headline
             below it; the 41sp wordmark that used to open the page is what made the hero taller than the
             composer. The cells on either side are 36dp controls with their own 8dp padding, so the
             lockup's weight-1 cell keeps the wordmark optically centred in the bar, not in the gap
             between two touch targets. -->
        <LinearLayout
            android:id="@+id/home_brand_lockup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/home_brand_mark"
                android:layout_width="@dimen/brand_mark_topbar"
                android:layout_height="@dimen/brand_mark_topbar"
                android:contentDescription="@string/cd_home_brand"
                android:scaleType="centerInside"
                android:src="@drawable/ic_brand_sprout" />

            <!-- Height is the declared line-height rather than wrap_content: the bundled serif's
                 2.858em CFF line box would otherwise make the bar taller than topbar_height.
                 WordmarkTextView centres the font box inside this frame. -->
            <com.treelearn.app.screen.WordmarkTextView
                android:id="@+id/home_brand"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/brand_topbar_line_height"
                android:layout_marginStart="@dimen/brand_topbar_gap"
                android:fontFamily="@font/noto_serif_sc"
                android:letterSpacing="0.06"
                android:text="@string/app_name"
                android:textColor="@color/tl_green_deep"
                android:textSize="@dimen/text_brand_topbar"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/home_settings_button"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_home_settings"
            android:padding="@dimen/space_s2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chat_gear"
            android:tint="@color/tl_ink2" />

    </LinearLayout>
</FrameLayout>

