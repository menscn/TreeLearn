<?xml version="1.0" encoding="utf-8"?>
<!--
  The branch-navigation column, aligned to Scheme A's third figure on 2026-10-22 (T-2026-10-22-057):
  the shared 13sp sans capsule topbar, the 28dp glass summary panel with its AI summary label and
  chevron fold, the single tracked list head with a real child count, the 17dp glass branch rows, and
  the dashed empty note that appears only when the current branch has no children. The phone layout
  and the tablet layout both include it, so the two configurations cannot drift.

  The fold is a chevron rather than the word 「折叠 / 展开」: Scheme A draws an icon, and the label
  survives as the icon's content description. Its 26dp box is the proposal's own; the summary head
  around it keeps the project's 44dp touch floor, so the whole head is the target and the icon only
  has to be seen.

  One card carries the branch the page is standing on: its title, the root tag a root branch wears
  instead of an archive control, and the branch's own summary. Every control a state can enable,
  disable or hide carries an id, and nothing here holds a decision: whether a branch may be archived
  arrives from the view state, so this file never restates it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigation_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_s6">

    <LinearLayout
        android:id="@+id/navigation_appbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:layout_marginStart="@dimen/space_s4"
        android:layout_marginTop="@dimen/topbar_offset"
        android:layout_marginEnd="@dimen/space_s4"
        android:background="@drawable/bg_glass_bar"
        android:elevation="@dimen/glass_capsule_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_s2">

        <ImageView
            android:id="@+id/navigation_back"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_navigation_back"
            android:padding="@dimen/space_s2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/tl_ink2" />

        <TextView
            android:id="@+id/navigation_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s2"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/navigation_title"
            android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_topbar_title"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/navigation_enter"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_navigation_enter"
            android:padding="@dimen/space_s2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_chat"
            android:tint="@color/tl_ink2" />

        <ImageButton
            android:id="@+id/navigation_canvas"
            android:layout_width="@dimen/topbar_icon"
            android:layout_height="@dimen/topbar_icon"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_navigation_canvas"
            android:padding="@dimen/space_s2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_tree"
            android:tint="@color/tl_ink2" />
    </LinearLayout>

    <TextView
        android:id="@+id/navigation_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s4"
        android:layout_marginTop="@dimen/space_s2"
        android:layout_marginEnd="@dimen/space_s4"
        android:textColor="@color/tl_amber"
        android:textSize="@dimen/text_sm"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/navigation_summary_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s4"
        android:layout_marginTop="@dimen/nav_gap"
        android:layout_marginEnd="@dimen/space_s4"
        android:background="@drawable/bg_summary_panel"
        android:elevation="@dimen/card_elevation"
        android:orientation="vertical"
        android:paddingStart="@dimen/nav_summary_pad"
        android:paddingTop="@dimen/nav_summary_pad"
        android:paddingEnd="@dimen/nav_summary_pad"
        android:paddingBottom="@dimen/nav_summary_pad_bottom">

        <LinearLayout
            android:id="@+id/navigation_summary_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_min"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navigation_current_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.45"
                android:maxLines="2"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_nav_summary_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navigation_current_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s2"
                android:background="@drawable/bg_root_tag"
                android:paddingStart="@dimen/nav_tag_pad_h"
                android:paddingTop="@dimen/nav_tag_pad_v"
                android:paddingEnd="@dimen/nav_tag_pad_h"
                android:paddingBottom="@dimen/nav_tag_pad_v"
                android:text="@string/navigation_root_chip"
                android:textColor="@color/tl_green_deep"
                android:textSize="@dimen/text_nav_tag"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/navigation_summary_fold"
                android:layout_width="@dimen/nav_fold_size"
                android:layout_height="@dimen/nav_fold_size"
                android:layout_marginStart="@dimen/space_s2"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/navigation_fold"
                android:padding="@dimen/nav_fold_pad"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/tl_ink3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navigation_summary_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/navigation_summary_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/nav_summary_label_top"
                android:layout_marginBottom="@dimen/nav_summary_label_bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/nav_summary_label_icon"
                    android:layout_height="@dimen/nav_summary_label_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    android:tint="@color/tl_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/nav_summary_label_gap"
                    android:letterSpacing="0.12"
                    android:text="@string/navigation_summary_title"
                    android:textColor="@color/tl_green"
                    android:textSize="@dimen/text_nav_label"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/navigation_summary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.78"
                android:maxLines="15"
                android:textColor="@color/tl_ink2"
                android:textSize="@dimen/text_nav_summary" />

            <TextView
                android:id="@+id/navigation_summary_stale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s2"
                android:text="@string/navigation_summary_stale"
                android:textColor="@color/tl_amber"
                android:textSize="@dimen/text_cap"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigation_list_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s4"
        android:layout_marginTop="@dimen/nav_gap"
        android:layout_marginEnd="@dimen/space_s4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navigation_rows_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.1"
            android:text="@string/navigation_rows_section"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_list_head"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navigation_rows_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_list_head" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigation_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s2"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/navigation_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s4"
        android:layout_marginEnd="@dimen/space_s4"
        android:background="@drawable/bg_empty_branch"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/nav_empty_pad_h"
        android:paddingTop="@dimen/nav_empty_pad_v"
        android:paddingEnd="@dimen/nav_empty_pad_h"
        android:paddingBottom="@dimen/nav_empty_pad_v"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/nav_empty_icon"
            android:layout_height="@dimen/nav_empty_icon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_brand_sprout"
            android:tint="@color/tl_green" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/nav_empty_gap"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.55"
            android:text="@string/navigation_empty"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_nav_empty" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigation_archived_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s4"
            android:layout_marginTop="@dimen/nav_gap"
            android:layout_marginEnd="@dimen/space_s4"
            android:letterSpacing="0.1"
            android:text="@string/navigation_archived_section"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_list_head"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/navigation_archived_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s2"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- One line carries all three read outcomes; the screen picks the sentence the phase calls for. -->
    <TextView
        android:id="@+id/navigation_phase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_s4"
        android:textColor="@color/tl_ink3"
        android:textSize="@dimen/text_sm"
        android:visibility="gone" />
</LinearLayout>
