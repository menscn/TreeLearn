<?xml version="1.0" encoding="utf-8"?>
<!--
  The menu the app draws over an answer's selection (PRD 6.2.19, 方案 V1.1 §2.1): six icon cells in
  one row, read left to right as 问 AI, 新建主题, 高亮, 批注, 复制, 全选. The platform's own selection
  toolbar is emptied by the screen, so this row is the only menu the learner sees.

  2026-09-28 user decisions: the menu used to be four full-width text rows under two captions
  (AI 操作 / 系统操作) naming the selected sentence at the top; the captions, the selection label and
  the text labels are all gone, and the mark pair joined the row as icons like every other cell -
  菜单格一律图标承载，不得文字按钮. 复制 and 全选 are their own cells in the row: the six-cell row is the
  terminal state, and there is no 更多 submenu. What carries the meaning now is the icon plus the
  order plus the contentDescription - never the drawing alone, which is why every cell keeps a
  description for a screen reader.

  The cells are equal-width and each one is a 44dp-tall target, so the six hotspots cannot overlap
  and every one of them is comfortably reachable (PRD 6.2.19 point 8). 新建主题 is hidden rather
  than disabled while an answer is unfinished, which is exception 1: the operation is not offered at
  all. The 1px separators are decor only - they are not focusable and never take a touch, and each
  one is drawn before the cell it belongs to, so `WordMenuPopup` can hide a folded cell's hairline
  with the cell instead of leaving a stray rule at the row's end. The mark pair rides the quote rule
  while the answer streams: drawn, but greyed. 高亮's glyph flips to the slashed marker when the
  selection sits exactly on an existing highlight - 取消高亮 is a state of this cell, not a seventh
  one (方案 §2.3); WordMenuPopup switches it at bind time.

  更多 is the last cell and starts hidden: it is the width fallback, not a menu. A window too narrow
  to draw the six cells whole keeps a prefix of them and folds the tail into 更多, which opens the
  vertical popup_word_more card; on a window with room for all six it is never drawn. The split is
  WordMenu#fitFor's decision, made from the window width and this file's own cell width.

  Its own width and height are measured by `WordMenuPopup`, which places the menu with those
  numbers, so nothing in this file decides where it lands.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/word_menu"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="@dimen/space_s1">

    <FrameLayout
        android:id="@+id/word_menu_ask_ai"
        android:layout_width="@dimen/word_menu_cell"
        android:layout_height="@dimen/touch_min"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/chat_word_ask_ai_desc"
        android:focusable="true">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sparkle"
            android:tint="@color/tl_ink" />
    </FrameLayout>

    <View
        android:id="@+id/word_menu_sep_fork"
        android:layout_width="@dimen/hairline"
        android:layout_height="@dimen/word_menu_sep"
        android:layout_gravity="center_vertical"
        android:background="@color/tl_line" />

    <FrameLayout
        android:id="@+id/word_menu_fork"
        android:layout_width="@dimen/word_menu_cell"
        android:layout_height="@dimen/touch_min"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/chat_word_fork_desc"
        android:focusable="true">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_action_fork"
            android:tint="@color/tl_ink" />
    </FrameLayout>

    <View
        android:id="@+id/word_menu_sep_highlight"
        android:layout_width="@dimen/hairline"
        android:layout_height="@dimen/word_menu_sep"
        android:layout_gravity="center_vertical"
        android:background="@color/tl_line" />

    <FrameLayout
        android:id="@+id/word_menu_highlight"
        android:layout_width="@dimen/word_menu_cell"
        android:layout_height="@dimen/touch_min"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/chat_word_highlight_desc"
        android:focusable="true">

        <ImageView
            android:id="@+id/word_menu_highlight_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_action_highlight"
            android:tint="@color/tl_ink" />
    </FrameLayout>

    <View
        android:id="@+id/word_menu_sep_note"
        android:layout_width="@dimen/hairline"
        android:layout_height="@dimen/word_menu_sep"
        android:layout_gravity="center_vertical"
        android:background="@color/tl_line" />

    <FrameLayout
        android:id="@+id/word_menu_note"
        android:layout_width="@dimen/word_menu_cell"
        android:layout_height="@dimen/touch_min"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/chat_word_note_desc"
        android:focusable="true">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_action_note"
            android:tint="@color/tl_ink" />
    </FrameLayout>

    <View
        android:id="@+id/word_menu_sep_copy"
        android:layout_width="@dimen/hairline"
        android:layout_height="@dimen/word_menu_sep"
        android:layout_gravity="center_vertical"
        android:background="@color/tl_line" />

    <FrameLayout
        android:id="@+id/word_menu_copy"
        android:layout_width="@dimen/word_menu_cell"
        android:layout_height="@dimen/touch_min"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/chat_word_copy_desc"
        android:focusable="true">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_action_copy"
            android:tint="@color/tl_ink" />
    </FrameLayout>

    <View
        android:id="@+id/word_menu_sep_select_all"
        android:layout_width="@dimen/hairline"
        android:layout_height="@dimen/word_menu_sep"
        android:layout_gravity="center_vertical"
        android:background="@color/tl_line" />

    <FrameLayout
        android:id="@+id/word_menu_select_all"
        android:layout_width="@dimen/word_menu_cell"
        android:layout_height="@dimen/touch_min"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/chat_word_select_all_desc"
        android:focusable="true">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_action_select_all"
            android:tint="@color/tl_ink" />
    </FrameLayout>

    <View
        android:id="@+id/word_menu_sep_more"
        android:layout_width="@dimen/hairline"
        android:layout_height="@dimen/word_menu_sep"
        android:layout_gravity="center_vertical"
        android:background="@color/tl_line"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/word_menu_more"
        android:layout_width="@dimen/word_menu_cell"
        android:layout_height="@dimen/touch_min"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/chat_word_more_desc"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_more"
            android:tint="@color/tl_ink" />
    </FrameLayout>
</LinearLayout>
