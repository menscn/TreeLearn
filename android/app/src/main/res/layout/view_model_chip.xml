<?xml version="1.0" encoding="utf-8"?>
<!-- The chip itself: current tier, plus the thinking marker while it is on (PRD 6.2.18 point 9). -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/model_chip"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/touch_min"
    android:background="@drawable/bg_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minWidth="@dimen/touch_min"
    android:paddingStart="@dimen/space_s3"
    android:paddingEnd="@dimen/space_s3"
    android:textColor="@color/tl_ink"
    android:textSize="@dimen/text_cap" />