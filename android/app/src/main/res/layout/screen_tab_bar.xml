<?xml version="1.0" encoding="utf-8"?>
<!--
  The bottom tab bar carries Home and Library. It belongs to
  the shell, not to any screen - activity_main.xml includes it once, and MainActivity shows or hides it
  from swap() - so no screen draws a bar of its own and no return path can drift.

  Each item is one tap target of at least @dimen/touch_min carrying an icon and its label. Icon and
  label are named per tab rather than sharing one pair of ids: multiple items in one layout that all
  answered to `tab_icon` would be a duplicate id, which this repository's lint gate aborts on, and the
  only declarative way around it (an item layout included multiple times) cannot give each copy its own
  `android:src` and label text. The selected/unselected state is likewise not spelled here on purpose:
  MainActivity tints the icon and the label with the token each state owns, which keeps "which tab is
  current" a single decision in one place.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_bar"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@android:color/transparent" android:orientation="vertical">

    <View android:layout_width="match_parent" android:layout_height="@dimen/hairline"
        android:background="@color/tl_line" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:baselineAligned="false" android:orientation="horizontal">

        <LinearLayout android:id="@+id/tab_home" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground" android:clickable="true"
            android:focusable="true" android:gravity="center" android:minHeight="@dimen/touch_min"
            android:orientation="vertical" android:paddingTop="@dimen/space_s2"
            android:paddingBottom="@dimen/space_s2">
            <ImageView android:id="@+id/tab_home_icon" android:layout_width="24dp"
                android:layout_height="24dp" android:importantForAccessibility="no"
                android:src="@drawable/ic_tab_home" />
            <TextView android:id="@+id/tab_home_label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s1"
                android:text="@string/tab_home" android:textSize="@dimen/text_cap" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tab_library" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground" android:clickable="true"
            android:focusable="true" android:gravity="center" android:minHeight="@dimen/touch_min"
            android:orientation="vertical" android:paddingTop="@dimen/space_s2"
            android:paddingBottom="@dimen/space_s2">
            <ImageView android:id="@+id/tab_library_icon" android:layout_width="24dp"
                android:layout_height="24dp" android:importantForAccessibility="no"
                android:src="@drawable/ic_tab_library" />
            <TextView android:id="@+id/tab_library_label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s1"
                android:text="@string/tab_library" android:textSize="@dimen/text_cap" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
