<?xml version="1.0" encoding="utf-8"?>
<!--
  The canvas column itself: the bar, the drawable and the three read phases. The phone layout and the
  tablet layout both include it, so phone and tablet cannot drift; only what surrounds it differs.

  The bar is two rows on purpose. A single row of five controls plus a title does not fit a 412dp
  phone once the labels are read at a large font scale, and the row would then overlap itself. Two
  rows cost 44dp of canvas and remove the whole class of collision.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tree_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tl_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/tree_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s3"
        android:paddingTop="@dimen/space_s2"
        android:paddingEnd="@dimen/space_s3">

        <Button
            android:id="@+id/tree_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_ghost"
            android:minHeight="@dimen/touch_min"
            android:minWidth="@dimen/touch_min"
            android:text="@string/tree_back"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/tree_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/space_s2"
            android:paddingEnd="@dimen/space_s2"
            android:text="@string/tree_title"
            android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_h1"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tree_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_ghost"
            android:minHeight="@dimen/touch_min"
            android:minWidth="@dimen/touch_min"
            android:text="@string/tree_nav"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tree_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s3"
        android:paddingEnd="@dimen/space_s3"
        android:paddingBottom="@dimen/space_s2">

        <Button
            android:id="@+id/tree_fold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_button_ghost"
            android:minHeight="@dimen/touch_min"
            android:text="@string/tree_fold"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_sm" />

        <Button
            android:id="@+id/tree_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:minHeight="@dimen/touch_min"
            android:text="@string/tree_open"
            android:textColor="@color/tl_surface"
            android:textSize="@dimen/text_sm" />

        <Button
            android:id="@+id/tree_fit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_button_ghost"
            android:minHeight="@dimen/touch_min"
            android:text="@string/tree_fit"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tree_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.treelearn.app.screen.TreeCanvasView
            android:id="@+id/tree_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tree_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/space_s4"
            android:text="@string/tree_loading"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tree_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/space_s4"
            android:text="@string/tree_empty"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tree_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/space_s4"
            android:text="@string/tree_error"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tree_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_s2"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingBottom="@dimen/space_s2"
        android:textColor="@color/tl_red"
        android:textSize="@dimen/text_sm"
        android:visibility="gone" />
</LinearLayout>
