<?xml version="1.0" encoding="utf-8"?>
<!--
  The canvas column itself: the bar, the drawable and the three read phases. The phone layout and the
  tablet layout both include it, so phone and tablet cannot drift; only what surrounds it differs.

  The app bar stays compact; canvas actions live on the drawing surface like the prototype.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tree_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/tree_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s3"
        android:paddingTop="@dimen/space_s2"
        android:paddingEnd="@dimen/space_s3">

        <ImageButton
            android:id="@+id/tree_back"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_tree_back"
            android:minHeight="@dimen/touch_min"
            android:minWidth="@dimen/touch_min"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/tl_ink2" />

        <LinearLayout
            android:id="@+id/tree_title_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_s2"
            android:paddingEnd="@dimen/space_s2">

            <TextView
                android:id="@+id/tree_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tree_canvas_title"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_h2"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tree_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tl_ink3"
                android:textSize="@dimen/text_cap" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/tree_nav"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_tree_nav"
            android:minHeight="@dimen/touch_min"
            android:minWidth="@dimen/touch_min"
            android:src="@drawable/ic_nav_tree"
            android:tint="@color/tl_ink2" />
    </LinearLayout>

    <!-- The control bar (058): the same three actions in the same order, their carrier switched from
         text to the shared line-icon convention. The fold control's icon and description follow the
         selected branch's state, set by TreeCanvasScreen.render(). -->
    <LinearLayout
        android:id="@+id/tree_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s3"
        android:paddingEnd="@dimen/space_s3"
        android:paddingBottom="@dimen/space_s2"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/tree_fold"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:background="@drawable/bg_button_ghost"
            android:contentDescription="@string/cd_tree_fold"
            android:minHeight="@dimen/touch_min"
            android:src="@drawable/ic_tree_fold"
            android:tint="@color/tl_ink2" />

        <ImageButton
            android:id="@+id/tree_open"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/space_s2"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:contentDescription="@string/cd_tree_open"
            android:minHeight="@dimen/touch_min"
            android:src="@drawable/ic_tree_open"
            android:tint="@color/tl_surface" />

        <ImageButton
            android:id="@+id/tree_fit"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/space_s2"
            android:layout_weight="1"
            android:background="@drawable/bg_button_ghost"
            android:contentDescription="@string/cd_tree_fit"
            android:minHeight="@dimen/touch_min"
            android:src="@drawable/ic_tree_fit"
            android:tint="@color/tl_ink2" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tree_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The dotted-grid backdrop (058): a pure decoration deliberately FIRST in the stage, so the
             canvas draws over it and every hit still lands on the canvas. -->
        <com.treelearn.app.screen.GridBackdrop
            android:id="@+id/canvas_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.treelearn.app.screen.TreeCanvasView
            android:id="@+id/tree_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/canvas_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="vertical"
            android:padding="@dimen/space_s3">

            <ImageButton
                android:id="@+id/tree_zoom_in"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_button_ghost"
                android:contentDescription="@string/cd_tree_zoom_in"
                android:minHeight="@dimen/touch_min"
                android:minWidth="@dimen/touch_min"
                android:src="@drawable/ic_zoom_in"
                android:tint="@color/tl_ink2" />

            <ImageButton
                android:id="@+id/tree_zoom_out"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_s2"
                android:background="@drawable/bg_button_ghost"
                android:contentDescription="@string/cd_tree_zoom_out"
                android:minHeight="@dimen/touch_min"
                android:minWidth="@dimen/touch_min"
                android:src="@drawable/ic_zoom_out"
                android:tint="@color/tl_ink2" />

            <ImageButton
                android:id="@+id/tree_fit_tool"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_s2"
                android:background="@drawable/bg_button_ghost"
                android:contentDescription="@string/cd_tree_fit"
                android:minHeight="@dimen/touch_min"
                android:minWidth="@dimen/touch_min"
                android:src="@drawable/ic_tree_fit"
                android:tint="@color/tl_ink2" />

            <ImageButton
                android:id="@+id/tree_center"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_s2"
                android:background="@drawable/bg_button_ghost"
                android:contentDescription="@string/cd_tree_center"
                android:minHeight="@dimen/touch_min"
                android:minWidth="@dimen/touch_min"
                android:src="@drawable/ic_tree_center"
                android:tint="@color/tl_ink2" />
        </LinearLayout>

        <TextView
            android:id="@+id/tree_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/space_s4"
            android:text="@string/tree_loading"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tree_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/space_s4"
            android:text="@string/tree_empty"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tree_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/space_s4"
            android:text="@string/tree_error"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tree_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_s2"
        android:paddingEnd="@dimen/page_gutter"
        android:paddingBottom="@dimen/space_s2"
        android:textColor="@color/tl_red"
        android:textSize="@dimen/text_sm"
        android:visibility="gone" />
</LinearLayout>
