<?xml version="1.0" encoding="utf-8"?>
<!--
  The row of answer actions (073 §3.5): the primary action first, then the version switcher, then
  the secondary icons. Each is enabled only where the store would accept it, which the screen reads
  from the message's own predicates; the actions a state does not offer are disabled rather than
  hidden, so the row does not reflow as an attempt starts and finishes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/answer_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <Button
        android:id="@+id/act_reset"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_act_reset"
        android:drawableStart="@drawable/ic_nav_restore"
        android:drawableTint="@color/tl_ink3"
        android:drawablePadding="0dp"
        android:minWidth="@dimen/touch_min"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text=""
        android:textColor="@color/tl_ink3"
        android:textSize="@dimen/text_cap" />

    <TextView
        android:id="@+id/act_version"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/space_s2"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="@dimen/touch_min"
        android:paddingStart="@dimen/space_s2"
        android:paddingEnd="@dimen/space_s2"
        android:textColor="@color/tl_ink2"
        android:textSize="@dimen/text_sm"
        android:visibility="gone" />

    <Button
        android:id="@+id/act_quote"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/space_s2"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_act_quote"
        android:drawableStart="@drawable/ic_action_quote"
        android:drawableTint="@color/tl_ink3"
        android:drawablePadding="0dp"
        android:minWidth="@dimen/touch_min"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text=""
        android:textColor="@color/tl_ink3"
        android:textSize="@dimen/text_cap" />

    <Button
        android:id="@+id/act_copy"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/space_s2"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_act_copy"
        android:drawableStart="@drawable/ic_action_copy"
        android:drawableTint="@color/tl_ink3"
        android:drawablePadding="0dp"
        android:minWidth="@dimen/touch_min"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text=""
        android:textColor="@color/tl_ink3"
        android:textSize="@dimen/text_cap" />

    <Button
        android:id="@+id/act_fork"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/space_s2"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_act_fork"
        android:drawableStart="@drawable/ic_action_fork"
        android:drawableTint="@color/tl_ink3"
        android:drawablePadding="0dp"
        android:minWidth="@dimen/touch_min"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text=""
        android:textColor="@color/tl_ink3"
        android:textSize="@dimen/text_cap" />

    <Button
        android:id="@+id/act_children"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/space_s2"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:minWidth="@dimen/touch_min"
        android:textColor="@color/tl_ink3"
        android:textSize="@dimen/text_cap"
        android:visibility="gone" />
</LinearLayout>
