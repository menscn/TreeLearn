<?xml version="1.0" encoding="utf-8"?>
<!--
  One archived branch, as the 「已完成」 segment draws it (T-053), aligned to Scheme A's library card on
  2026-10-22 (T-2026-10-22-057). The card geometry and type are the live topic card's - the same 12dp /
  13dp padding, 12.5sp title and 9sp meta - so an archived branch reads as the branch it was rather
  than as a different kind of thing. The old 3dp accent bar is gone here too: the archived mark already
  names the state, and the proposal draws no second colour bar.

  Three lines, and one of them is optional: the title, the branch's own summary, and the row's own
  facts (the archived mark and where the branch came from). The summary is `gone` until the derived
  service has written one, and the row then draws one line fewer - never a sentence standing in for it
  (PRD item 7 forbids "摘要将随本分支对话自动更新" on exactly this kind of surface).

  The confirmation is inline rather than a dialog: the row asks, the row names the exact number of
  branches the deletion removes, and nothing is written until 「永久删除」 is tapped. That number comes
  from the presenter, which counted it from the branch's own tree; this layout only holds the place.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/library_done_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/page_gutter"
    android:layout_marginEnd="@dimen/page_gutter"
    android:layout_marginBottom="@dimen/library_card_gap"
    android:background="@drawable/bg_library_card"
    android:elevation="@dimen/card_elevation"
    android:orientation="vertical"
    android:paddingStart="@dimen/library_card_pad_h"
    android:paddingTop="@dimen/library_card_pad_v"
    android:paddingEnd="@dimen/library_card_pad_h"
    android:paddingBottom="@dimen/library_card_pad_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/library_done_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.45"
                android:maxLines="2"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_library_card_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/library_done_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s1"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.55"
                android:maxLines="2"
                android:textColor="@color/tl_ink2"
                android:textSize="@dimen/text_library_summary"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/library_meta_top"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/library_done_mark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/tl_amber_soft"
                    android:paddingStart="@dimen/space_s2"
                    android:paddingEnd="@dimen/space_s2"
                    android:textColor="@color/tl_amber"
                    android:textSize="@dimen/text_library_meta" />

                <TextView
                    android:id="@+id/library_done_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/library_meta_gap"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tl_ink3"
                    android:textSize="@dimen/text_library_meta" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/library_done_restore"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:minWidth="@dimen/touch_min"
            android:stateListAnimator="@null"
            android:text="@string/done_restore"
            android:textColor="@color/tl_green_deep"
            android:textSize="@dimen/text_cap" />

        <Button
            android:id="@+id/library_done_delete"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_danger_link_ripple"
            android:minWidth="@dimen/touch_min"
            android:stateListAnimator="@null"
            android:text="@string/done_delete"
            android:textColor="@color/tl_red"
            android:textSize="@dimen/text_cap" />
    </LinearLayout>

    <TextView
        android:id="@+id/library_done_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_s2"
        android:textColor="@color/tl_ink2"
        android:textSize="@dimen/text_cap"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/library_done_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_s2"
        android:visibility="gone">

        <Button
            android:id="@+id/library_done_cancel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_icon_button"
            android:minWidth="@dimen/touch_min"
            android:stateListAnimator="@null"
            android:text="@string/done_delete_cancel"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_cap" />

        <Button
            android:id="@+id/library_done_confirm"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/space_s2"
            android:background="@drawable/bg_danger_link_ripple"
            android:minWidth="@dimen/touch_min"
            android:stateListAnimator="@null"
            android:text="@string/done_delete_confirm"
            android:textColor="@color/tl_red"
            android:textSize="@dimen/text_cap" />
    </LinearLayout>
</LinearLayout>
