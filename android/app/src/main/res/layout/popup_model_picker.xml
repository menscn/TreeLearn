<?xml version="1.0" encoding="utf-8"?>
<!--
  The model popover that hangs off the composer chip (PRD 6.2.18 point 3): it is anchored to the chip
  and stays attached to it, it is not a sheet. Every row is a full 44dp tap target.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:elevation="@dimen/card_elevation"
    android:minWidth="@dimen/picker_min_width"
    android:orientation="vertical"
    android:padding="@dimen/space_s2">

    <LinearLayout
        android:id="@+id/picker_flash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="@dimen/touch_min"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_s3"
        android:paddingTop="@dimen/space_s2"
        android:paddingEnd="@dimen/space_s3"
        android:paddingBottom="@dimen/space_s2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/model_flash_full"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:id="@+id/picker_flash_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s2"
                android:textColor="@color/tl_green_deep"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_flash_desc"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_cap" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/picker_pro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="@dimen/touch_min"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_s3"
        android:paddingTop="@dimen/space_s2"
        android:paddingEnd="@dimen/space_s3"
        android:paddingBottom="@dimen/space_s2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/model_pro_full"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:id="@+id/picker_pro_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s2"
                android:textColor="@color/tl_green_deep"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_pro_desc"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_cap" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:layout_marginTop="@dimen/space_s1"
        android:layout_marginBottom="@dimen/space_s1"
        android:background="@color/tl_line" />

    <LinearLayout
        android:id="@+id/picker_thinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_s3"
        android:paddingEnd="@dimen/space_s3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/model_thinking_label"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/model_thinking_desc"
                android:textColor="@color/tl_ink3"
                android:textSize="@dimen/text_cap" />
        </LinearLayout>

        <TextView
            android:id="@+id/picker_thinking_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s2"
            android:textColor="@color/tl_green_deep"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>
</LinearLayout>