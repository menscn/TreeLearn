<?xml version="1.0" encoding="utf-8"?>
<!--
  The child-branch list of one answer (prototype v2.5 `.popover`, PRD 6.2.20 point 7): the count it
  was opened for, then one row per unarchived child in creation order. The rows are added by
  `ChildBranchPopup` from the branches the presenter read, so this file carries no list logic.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/child_branches_popup"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_s4"
    android:paddingTop="@dimen/space_s3"
    android:paddingEnd="@dimen/space_s4"
    android:paddingBottom="@dimen/space_s3">

    <TextView
        android:id="@+id/child_branches_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:paddingBottom="@dimen/space_s2"
        android:textColor="@color/tl_ink"
        android:textSize="@dimen/text_h1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:background="@color/tl_line" />

    <!-- T-041 D1: the scroll container the navigation page's list already has - a popup clips at
         the window edge, so rows past one screen were unreachable without it. -->
    <ScrollView
        android:id="@+id/child_branches_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s2"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/child_branches_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
