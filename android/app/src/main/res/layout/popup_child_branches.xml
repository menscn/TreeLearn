<?xml version="1.0" encoding="utf-8"?>
<!--
  The child-branch list of one answer (prototype v2.5 `.popover`, PRD 6.2.20 point 7): the count it
  was opened for, then one row per unarchived child in creation order. The rows are added by
  `ChildBranchPopup` from the branches the presenter read, so this file carries no list logic.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/child_branches_popup"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/space_s3">

    <TextView
        android:id="@+id/child_branches_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/space_s1"
        android:textColor="@color/tl_ink"
        android:textSize="@dimen/text_h2" />

    <!-- T-041 D1: the scroll container the navigation page's list already has - a popup clips at
         the window edge, so rows past one screen were unreachable without it. -->
    <ScrollView
        android:id="@+id/child_branches_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/child_branches_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
