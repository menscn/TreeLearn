<?xml version="1.0" encoding="utf-8"?>
<!-- 统计详情页（T-104）：全量热力图（近 10 周，复用 T-101 的 HeatmapView grid）+ 三张累计指标卡 + 空态/失败降级。
     入口由抽屉（T-106）接线；返回走 MainActivity 的既有房间返回链。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_gutter" android:paddingEnd="@dimen/page_gutter"
    android:paddingBottom="@dimen/space_s8">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingTop="@dimen/space_s4">

        <ImageView android:id="@+id/stats_detail_back"
            android:layout_width="@dimen/touch_min" android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/cd_stats_back"
            android:src="@drawable/ic_nav_back" android:tint="@color/tl_green_deep" />

        <TextView android:id="@+id/stats_detail_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="@dimen/space_s3"
            android:text="@string/stats_detail_title" android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_h1" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/stats_detail_failed"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s3" android:text="@string/stats_failed"
        android:textColor="@color/tl_amber" android:textSize="@dimen/text_sm"
        android:visibility="gone" />

    <TextView android:id="@+id/stats_detail_empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s6" android:text="@string/stats_empty"
        android:textColor="@color/tl_ink3" android:textSize="@dimen/text_sm"
        android:visibility="gone" />

    <HorizontalScrollView android:id="@+id/stats_heat_scroll"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s4" android:scrollbars="none">

        <LinearLayout android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="vertical">

            <com.treelearn.app.ui.HeatmapView android:id="@+id/stats_heat_cells"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                tl:tl_columns="70" tl:tl_gap="2dp" tl:tl_mode="grid" tl:tl_rows="7"
                tl:tl_cellSize="10dp"
                xmlns:tl="http://schemas.android.com/apk/res-auto" />

            <TextView android:id="@+id/stats_heat_caption"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s2" android:text="@string/stats_heat_caption"
                android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout android:id="@+id/stats_metric_row"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s4" android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_s2" android:layout_weight="1"
            android:background="@drawable/bg_card" android:orientation="vertical"
            android:padding="@dimen/space_s3">

            <TextView android:id="@+id/stats_metric_questions"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/tl_ink" android:textSize="@dimen/text_h2"
                android:textStyle="bold" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s1" android:text="@string/stats_metric_questions"
                android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_s2" android:layout_weight="1"
            android:background="@drawable/bg_card" android:orientation="vertical"
            android:padding="@dimen/space_s3">

            <TextView android:id="@+id/stats_metric_messages"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/tl_ink" android:textSize="@dimen/text_h2"
                android:textStyle="bold" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s1" android:text="@string/stats_metric_messages"
                android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_s3">

            <TextView android:id="@+id/stats_metric_streak"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/tl_ink" android:textSize="@dimen/text_h2"
                android:textStyle="bold" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s1" android:text="@string/stats_metric_streak"
                android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
