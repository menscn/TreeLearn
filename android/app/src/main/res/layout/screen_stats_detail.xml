<?xml version="1.0" encoding="utf-8"?>
<!-- 统计详情页（T-2026-09-27-012）：指标卡在前，当前月份 7 列月历在后；历史数据仍由同一聚合入口提供。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_gutter" android:paddingEnd="@dimen/page_gutter">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingTop="@dimen/space_s4">

        <ImageView android:id="@+id/stats_detail_back"
            android:layout_width="@dimen/touch_min" android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/cd_stats_back"
            android:src="@drawable/ic_nav_back" android:tint="@color/tl_green_deep" />

        <TextView android:id="@+id/stats_detail_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="@dimen/space_s3"
            android:text="@string/stats_detail_title" android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_h1" android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_s8" android:orientation="vertical">

            <TextView android:id="@+id/stats_detail_failed"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s3" android:text="@string/stats_failed"
                android:textColor="@color/tl_amber" android:textSize="@dimen/text_sm"
                android:visibility="gone" />

            <LinearLayout android:id="@+id/stats_metric_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s4" android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_s2" android:layout_weight="1"
                    android:background="@drawable/bg_card" android:gravity="center_horizontal"
                    android:orientation="vertical" android:padding="@dimen/space_s4">
                    <TextView android:id="@+id/stats_metric_streak"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/tl_green_deep" android:textSize="@dimen/text_display"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s1" android:text="@string/stats_metric_streak"
                        android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_s2" android:layout_weight="1"
                    android:background="@drawable/bg_card" android:gravity="center_horizontal"
                    android:orientation="vertical" android:padding="@dimen/space_s4">
                    <TextView android:id="@+id/stats_metric_questions"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/tl_green_deep" android:textSize="@dimen/text_display"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s1" android:text="@string/stats_metric_questions"
                        android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:background="@drawable/bg_card"
                    android:gravity="center_horizontal" android:orientation="vertical"
                    android:padding="@dimen/space_s4">
                    <TextView android:id="@+id/stats_metric_messages"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/tl_green_deep" android:textSize="@dimen/text_display"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s1" android:text="@string/stats_metric_messages"
                        android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/stats_heat_scroll"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s4" android:background="@drawable/bg_card"
                android:orientation="vertical" android:padding="@dimen/space_s4">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/stats_heat_title"
                        android:textColor="@color/tl_ink" android:textSize="@dimen/text_sm"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/stats_heat_month"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                </LinearLayout>

                <TextView android:id="@+id/stats_detail_empty"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s3" android:text="@string/stats_empty"
                    android:textColor="@color/tl_ink3" android:textSize="@dimen/text_sm"
                    android:visibility="gone" />

                <LinearLayout android:id="@+id/stats_heat_weekdays"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s3" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:text="@string/stats_weekday_mon" android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:text="@string/stats_weekday_tue" android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:text="@string/stats_weekday_wed" android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:text="@string/stats_weekday_thu" android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:text="@string/stats_weekday_fri" android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:text="@string/stats_weekday_sat" android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:text="@string/stats_weekday_sun" android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                </LinearLayout>

                <com.treelearn.app.ui.MonthCalendarView android:id="@+id/stats_heat_cells"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s2"
                    android:contentDescription="@string/stats_heat_cd" />

                <LinearLayout android:id="@+id/stats_heat_legend"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s3" android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stats_heat_less" android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                    <View android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="@dimen/space_s1" android:background="@color/tl_line" />
                    <View android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="@dimen/space_s1" android:background="@color/tl_green_faint" />
                    <View android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="@dimen/space_s1" android:background="@color/tl_green_soft" />
                    <View android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="@dimen/space_s1" android:background="@color/tl_green" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s1" android:text="@string/stats_heat_more"
                        android:textColor="@color/tl_ink3" android:textSize="@dimen/text_cap" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
