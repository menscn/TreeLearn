<?xml version="1.0" encoding="utf-8"?>
<!--
  The node card a tap opens: which branch, what it carries, and the two things to do with it. Its size
  is what the presenter places it with, so it stays deliberately small - a fold control, the branch's
  name and the way into the conversation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/space_s3">

    <TextView
        android:id="@+id/node_popup_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/tl_ink"
        android:textSize="@dimen/text_h2" />

    <TextView
        android:id="@+id/node_popup_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="@dimen/space_s1"
        android:textColor="@color/tl_ink2"
        android:textSize="@dimen/text_sm" />

    <TextView
        android:id="@+id/node_popup_unread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_s1"
        android:textColor="@color/tl_amber"
        android:textSize="@dimen/text_sm" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_s2">

        <Button
            android:id="@+id/node_popup_fold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_ghost"
            android:minHeight="@dimen/touch_min"
            android:minWidth="@dimen/touch_min"
            android:text="@string/tree_fold"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_sm" />

        <Button
            android:id="@+id/node_popup_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_primary"
            android:minHeight="@dimen/touch_min"
            android:minWidth="@dimen/touch_min"
            android:text="@string/tree_open"
            android:textColor="@color/tl_surface"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>
</LinearLayout>
