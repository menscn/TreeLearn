<?xml version="1.0" encoding="utf-8"?>
<!--
  One answer style on the introduction page (persona prototype 03): the name, its one-word
  positioning, and the same question answered in that style. The demo is static design copy - it is
  not generated and makes no promise about how the model will answer (see the spec's 03 note).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s3"
    android:background="@drawable/bg_card"
    android:elevation="@dimen/card_elevation"
    android:orientation="vertical"
    android:padding="@dimen/space_s4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/persona_intro_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_h2"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/persona_intro_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s2"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/tl_green_soft"
            android:paddingStart="@dimen/space_s2"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/space_s2"
            android:paddingBottom="2dp"
            android:textColor="@color/tl_green_deep"
            android:textSize="@dimen/text_cap"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/persona_intro_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s1"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/tl_ink2"
        android:textSize="@dimen/text_sm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s3"
        android:background="@drawable/bg_persona_demo"
        android:orientation="vertical"
        android:padding="@dimen/space_s3">

        <TextView
            android:id="@+id/persona_intro_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_cap" />

        <TextView
            android:id="@+id/persona_intro_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s2"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>
</LinearLayout>
