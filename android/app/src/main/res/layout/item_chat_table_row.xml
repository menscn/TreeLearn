<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of a table inside an answer. The row itself is a 1dp spacer: the table's own background is
  the hairline colour, so the gap between two rows of cells reads as a rule across the whole table
  width without drawing anything. The header row gets its own rule underneath for the same reason.
-->
<TableRow xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_table_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
