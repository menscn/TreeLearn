<?xml version="1.0" encoding="utf-8"?>
<!--
  One header cell of a table in an answer. Same shape as item_chat_table_cell, with the two
  differences the header carries: the secondary ink in bold, and the page colour underneath so the
  header band reads as a band across the full table width.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/tl_bg"
    android:paddingStart="@dimen/space_s2"
    android:paddingTop="@dimen/space_s2"
    android:paddingEnd="@dimen/space_s2"
    android:paddingBottom="@dimen/space_s2"
    android:textColor="@color/tl_ink2"
    android:textSize="@dimen/text_sm"
    android:textStyle="bold" />
