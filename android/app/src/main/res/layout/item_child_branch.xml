<?xml version="1.0" encoding="utf-8"?>
<!--
  One child branch in the answer's inline stack (Scheme A .branch-item.glass): a 14dp glass card
  with the fork glyph and the branch title. The whole card is the 44dp target, so a list of
  children is a list of reachable choices; the unread count rides at the end.

  2026-10-22: the trailing chevron is gone with the popup. The card itself opens the branch, so a
  second arrow would imply a second action inside the row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/child_branch_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/branch_item_gap"
    android:background="@drawable/bg_branch_item"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/branch_item_pad_h"
    android:paddingTop="@dimen/branch_item_pad_v"
    android:paddingEnd="@dimen/branch_item_pad_h"
    android:paddingBottom="@dimen/branch_item_pad_v">

    <ImageView
        android:layout_width="@dimen/branch_icon"
        android:layout_height="@dimen/branch_icon"
        android:layout_marginEnd="@dimen/branch_item_icon_gap"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_action_fork"
        android:tint="@color/tl_green" />

    <TextView
        android:id="@+id/child_branch_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.5"
        android:maxLines="3"
        android:textColor="@color/tl_ink2"
        android:textSize="@dimen/text_branch_item" />

    <TextView
        android:id="@+id/child_branch_unread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s2"
        android:background="@drawable/bg_popup_unread"
        android:paddingStart="@dimen/space_s2"
        android:paddingTop="@dimen/space_s1"
        android:paddingEnd="@dimen/space_s2"
        android:paddingBottom="@dimen/space_s1"
        android:textColor="@color/tl_amber"
        android:textSize="@dimen/text_cap"
        android:visibility="gone" />
</LinearLayout>
