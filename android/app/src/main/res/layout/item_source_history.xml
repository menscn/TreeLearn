<?xml version="1.0" encoding="utf-8"?>
<!--
  T-065: one row of the source card's upstream history. Plain read-only text - the upstream
  conversation is rendered, never re-asked, and a row that cannot be resolved is simply not added.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/source_history_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/page_gutter"
    android:paddingEnd="@dimen/page_gutter"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:textColor="@color/tl_ink2"
    android:textSize="@dimen/text_sm" />
