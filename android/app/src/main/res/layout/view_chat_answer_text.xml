<?xml version="1.0" encoding="utf-8"?>
<!--
  One prose run of an answer (2026-09-28 user decision: a GFM table is a view, not text).

  The answer used to be a single fixed TextView. It is now a sequence - prose runs and tables - so
  the runs are inflated from this file instead of living under a fixed id. Everything else about the
  run is what chat_answer always was: body ink, body size, selectable, and no background of its own.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_answer_run"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:lineSpacingMultiplier="1.82"
    android:textColor="@color/tl_ink"
    android:textIsSelectable="true"
    android:textSize="@dimen/text_answer" />
