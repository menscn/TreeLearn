<?xml version="1.0" encoding="utf-8"?>
<!--
  Body of the API KEY room (settings redesign, 2026-09-28). Two cards: the credential's state on
  top, the replace form under it. The save control is a 44dp icon button, the room's only filled
  element; delete is a red text link with a confirm dialog, never a button next to save (PRD 6.2.13
  keeps the mask, replace and delete contract, only their places move).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_s8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_s4"
        android:paddingEnd="@dimen/page_gutter">

        <ImageView
            android:id="@+id/settings_key_back"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="-8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/tl_green_deep" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s2"
            android:text="@string/settings_key_page_title"
            android:textColor="@color/tl_ink"
            android:textSize="@dimen/text_h1"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="@dimen/space_s4"
        android:layout_marginEnd="@dimen/page_gutter"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/card_elevation"
        android:orientation="vertical"
        android:padding="@dimen/space_s4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settings_key_mask"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tl_ink"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/settings_key_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s2"
                android:background="@drawable/bg_pill"
                android:paddingStart="@dimen/space_s2"
                android:paddingTop="@dimen/space_s1"
                android:paddingEnd="@dimen/space_s2"
                android:paddingBottom="@dimen/space_s1"
                android:textSize="@dimen/text_cap" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s1"
            android:text="@string/settings_key_sub"
            android:textColor="@color/tl_ink2"
            android:textSize="@dimen/text_sm" />

        <View
            android:id="@+id/settings_key_delete_rule"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:layout_marginTop="@dimen/space_s3"
            android:background="@color/tl_line" />

        <TextView
            android:id="@+id/settings_key_delete_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s3"
            android:background="@drawable/bg_danger_link_ripple"
            android:paddingTop="@dimen/space_s1"
            android:paddingBottom="@dimen/space_s1"
            android:text="@string/settings_key_delete_link"
            android:textColor="@color/tl_red"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="@dimen/space_s2"
        android:layout_marginEnd="@dimen/page_gutter"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/card_elevation"
        android:orientation="vertical"
        android:padding="@dimen/space_s4">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_key_replace_title"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_cap" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/settings_key_input"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:hint="@string/settings_key_input_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="@dimen/space_s3"
                android:paddingEnd="@dimen/space_s3"
                android:textColor="@color/tl_ink"
                android:textColorHint="@color/tl_ink3"
                android:textSize="@dimen/text_sm" />

            <ImageView
                android:id="@+id/settings_key_save"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/space_s2"
                android:background="@drawable/bg_save_ico"
                android:contentDescription="@string/cd_settings_key_save"
                android:padding="@dimen/space_s2"
                android:scaleType="centerInside"
                android:src="@drawable/ic_check" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s2"
            android:text="@string/settings_key_replace_sub"
            android:textColor="@color/tl_ink3"
            android:textSize="@dimen/text_cap" />

        <TextView
            android:id="@+id/settings_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s2"
            android:textColor="@color/tl_red"
            android:textSize="@dimen/text_sm"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
