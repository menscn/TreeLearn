<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      API 35+ only: opt out of the enforced edge-to-edge so the composer keeps its T-063
      IME behaviour. On lower API levels the platform ignores the attribute anyway, so the
      base theme simply does not carry it (lint NewApi).
    -->
    <style name="Theme.TreeLearn" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

</resources>
