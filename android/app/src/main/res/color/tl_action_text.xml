<?xml version="1.0" encoding="utf-8"?>
<!-- An actionable label's ink with a disabled step (2026-10-16), the same reasoning as tl_glyph for
     the glyphs: a control that cannot take the tap must not read as one that can. Used by text-faced
     controls - the retry key, the follow-latest glyph - whose enabled flag the view state sets. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/tl_line" />
    <item android:color="@color/tl_green_deep" />
</selector>
