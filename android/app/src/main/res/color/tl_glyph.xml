<?xml version="1.0" encoding="utf-8"?>
<!-- A glyph's ink with a disabled step (2026-10-16). The answer action row's own contract says "a
     button that looks pressable is a command the store accepts" (AnswerActionBar), but the glyphs were
     tinted with the flat @color/tl_ink3, so a disabled one - 重新生成 before the answer has a revision
     to regenerate from - drew exactly like an enabled one and swallowed the tap with no signal at all.
     The inactive step takes tl_line, the token the send key already uses for "not available yet";
     WCAG 1.4.3 exempts inactive controls from contrast, and the content description still names the
     action. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/tl_line" />
    <item android:color="@color/tl_ink3" />
</selector>
