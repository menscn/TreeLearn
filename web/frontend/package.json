{
  "name": "treelearn-web-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm check:design && vite",
    "build": "pnpm check:design && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && node scripts/check-user-copy-i18n.mjs",
    "check:user-copy-i18n": "node scripts/check-user-copy-i18n.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:design": "pnpm check:design-tokens && pnpm check:contrast && pnpm check:user-copy-i18n",
    "generate:tokens": "node scripts/generate-design-tokens.mjs"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "2.0.1",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}